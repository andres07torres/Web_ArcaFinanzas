{% extends 'base_dashboard.html.twig' %}

{% set active_menu = 'actividades' %}

{% block title %}Arca Finanzas - Actividades y Eventos{% endblock %}

{% block dashboard_content %}
	<div class="p-lg max-w-container-max mx-auto w-full">
		<div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
			<div>
				<nav class="flex items-center gap-xs text-on-surface-variant font-label-bold text-label-bold mb-xs">
					<span>Organización</span>
					<span class="material-symbols-outlined text-xs">chevron_right</span>
					<span class="text-primary">Actividades</span>
				</nav>
				<h1 class="font-headline-lg text-headline-lg text-on-background">Gestión de Eventos</h1>
				<p class="text-on-surface-variant font-body-md mt-xs">Rastree, gestione y cierre eventos de recaudación de fondos y actividades ministeriales.</p>
			</div>
			<a href="{{ path('app_actividades_nueva') }}" onclick="event.preventDefault(); document.getElementById('newActivityModal').classList.remove('hidden');" data-new-activity="true" class="bg-primary text-on-primary px-xl py-md rounded-xl font-label-bold text-label-bold shadow-md hover:bg-primary-container transition-all flex items-center justify-center gap-sm">
				<span class="material-symbols-outlined text-base">add</span>
				Nueva Actividad
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-lg mb-xl">
			<div class="bg-surface border border-outline-variant rounded-xl p-lg shadow-sm">
				<div class="flex justify-between items-start mb-md">
					<span class="p-sm bg-secondary-container text-on-secondary-container rounded-lg material-symbols-outlined">trending_up</span>
					<span class="text-secondary font-label-bold text-label-bold">{{ active_count }} Activas</span>
				</div>
				<p class="font-label-bold text-label-bold text-on-surface-variant">Total Fondos Recaudados</p>
				<h3 class="font-headline-md text-headline-md text-on-background mt-xs">${{ total_raised|number_format(2, '.', ',') }}</h3>
			</div>
			<div class="bg-surface border border-outline-variant rounded-xl p-lg shadow-sm">
				<div class="flex justify-between items-start mb-md">
					<span class="p-sm bg-primary-fixed text-on-primary-fixed rounded-lg material-symbols-outlined">event</span>
					<span class="text-on-surface-variant font-label-bold text-label-bold">{{ active_count }} Activas</span>
				</div>
				<p class="font-label-bold text-label-bold text-on-surface-variant">Actividades en Curso</p>
				<h3 class="font-headline-md text-headline-md text-on-background mt-xs">{{ active_count }}</h3>
			</div>
			<div class="bg-surface border border-outline-variant rounded-xl p-lg shadow-sm">
				<div class="flex justify-between items-start mb-md">
					<span class="p-sm bg-tertiary-fixed text-on-tertiary-fixed rounded-lg material-symbols-outlined">account_balance</span>
					<span class="text-secondary font-label-bold text-label-bold">{{ finished_count }} Finalizadas</span>
				</div>
				<p class="font-label-bold text-label-bold text-on-surface-variant">Actividades Finalizadas</p>
				<h3 class="font-headline-md text-headline-md text-on-background mt-xs">{{ finished_count }}</h3>
			</div>
		</div>

		<div class="flex items-center gap-md border-b border-outline-variant mb-lg overflow-x-auto pb-xs custom-scrollbar">
			<button type="button" data-status="all" class="activity-tab-btn px-lg py-md border-b-2 border-primary text-primary font-bold whitespace-nowrap cursor-pointer transition-colors">Todas las Actividades</button>
			<button type="button" data-status="active" class="activity-tab-btn px-lg py-md text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap cursor-pointer">Activas ({{ active_count }})</button>
			<button type="button" data-status="finished" class="activity-tab-btn px-lg py-md text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap cursor-pointer">Finalizadas ({{ finished_count }})</button>
			<button type="button" data-status="cancelled" class="activity-tab-btn px-lg py-md text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap cursor-pointer">Canceladas ({{ cancelled_count }})</button>
		</div>

		{% if activities|length == 0 %}
			<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-xl shadow-sm text-center">
				<span class="material-symbols-outlined text-6xl text-on-surface-variant opacity-40">event_available</span>
				<h3 class="font-headline-sm text-headline-sm text-on-background mt-md">No hay actividades registradas</h3>
				<p class="text-on-surface-variant font-body-sm mt-xs">Comienza creando tu primera actividad o evento.</p>
			</div>
		{% else %}
			<div id="noActivitiesMessage" class="hidden bg-surface-container-lowest border border-outline-variant rounded-xl p-xl shadow-sm text-center py-12">
				<span class="material-symbols-outlined text-4xl text-on-surface-variant opacity-40 mb-xs">filter_alt_off</span>
				<h3 class="font-bold text-body-lg text-on-background">No hay actividades en esta categoría</h3>
				<p class="text-on-surface-variant text-xs mt-xs">Selecciona otra pestaña para consultar el resto de tus eventos.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-md" id="activitiesGrid">
				{% for activity in activities %}
					{% set progress = activity.goalAmount > 0 ? ((activity.raisedAmount / activity.goalAmount) * 100)|round(0) : 0 %}

					{% if activity.status == 'active' %}
						<div data-card-status="active" class="activity-card bg-surface-container-lowest border border-outline-variant rounded-xl p-md shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
							<div>
								<div class="flex justify-between items-start mb-md">
									<div class="flex items-center gap-md">
										<div class="w-11 h-11 rounded-lg bg-secondary-container flex items-center justify-center text-on-secondary-container shrink-0">
											<span class="material-symbols-outlined text-xl">festival</span>
										</div>
										<div>
											<span class="bg-secondary-container text-on-secondary-container text-[10px] px-xs py-[1px] rounded-full font-label-bold uppercase">Activa</span>
											<h4 class="font-bold text-body-lg text-on-background mt-0.5">{{ activity.name }}</h4>
											<p class="text-on-surface-variant text-xs">{{ activity.startDate|date('d/m/Y') }} - {{ activity.endDate|date('d/m/Y') }}</p>
										</div>
									</div>
								</div>
								<div class="space-y-xs">
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant">Progreso meta</span>
										<span class="font-bold text-on-background">{{ progress }}%</span>
									</div>
									<div class="w-full h-1.5 bg-surface-variant rounded-full overflow-hidden">
										<div class="h-full bg-secondary rounded-full transition-all duration-500" style="width: {{ progress }}%;"></div>
									</div>
									<div class="grid grid-cols-2 gap-sm pt-xs">
										<div>
											<p class="font-label-bold text-[10px] text-on-surface-variant uppercase">Recaudado</p>
											<p class="text-body-md font-bold text-secondary">${{ activity.raisedAmount|number_format(2, '.', ',') }}</p>
										</div>
										<div>
											<p class="font-label-bold text-[10px] text-on-surface-variant uppercase">Meta</p>
											<p class="text-body-md font-bold text-on-background">${{ activity.goalAmount|number_format(2, '.', ',') }}</p>
										</div>
									</div>
								</div>
							</div>
							<div class="mt-md pt-xs border-t border-outline-variant flex items-center gap-xs flex-wrap">
								<a href="{{ path('app_actividades_detalle', {id: activity.id}) }}" class="h-8 px-md border border-outline text-on-surface-variant rounded-md font-label-bold text-xs hover:bg-surface-variant transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
									<span class="material-symbols-outlined text-sm">visibility</span> Ver Detalles
								</a>
								<a href="{{ path('app_actividades_editar', {id: activity.id}) }}"
								   data-edit-activity="true"
								   data-id="{{ activity.id }}"
								   data-name="{{ activity.name|e('html_attr') }}"
								   data-description="{{ activity.description|e('html_attr') }}"
								   data-category="{{ activity.category|e('html_attr') }}"
								   data-goal="{{ activity.goalAmount }}"
								   data-start="{{ activity.startDate ? activity.startDate|date('Y-m-d') : '' }}"
								   data-end="{{ activity.endDate ? activity.endDate|date('Y-m-d') : '' }}"
								   class="h-8 px-md border border-secondary text-secondary rounded-md font-label-bold text-xs hover:bg-secondary hover:text-on-secondary transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
									<span class="material-symbols-outlined text-sm">edit</span> Editar
								</a>
								<form method="post" action="{{ path('app_actividades_cerrar', {id: activity.id}) }}" class="inline-block">
									<button type="submit" class="h-8 px-md bg-primary text-on-primary rounded-md font-label-bold text-xs hover:bg-primary-container transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
										Cerrar
									</button>
								</form>
							</div>
						</div>

					{% elseif activity.status == 'finished' %}
						<div data-card-status="finished" class="activity-card bg-surface-container-lowest border border-outline-variant rounded-xl p-md shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
							<div>
								<div class="flex justify-between items-start mb-md">
									<div class="flex items-center gap-md">
										<div class="w-11 h-11 rounded-lg bg-surface-variant flex items-center justify-center text-on-surface-variant shrink-0">
											<span class="material-symbols-outlined text-xl">volunteer_activism</span>
										</div>
										<div>
											<span class="bg-surface-variant text-on-surface-variant text-[10px] px-xs py-[1px] rounded-full font-label-bold uppercase">Finalizada</span>
											<h4 class="font-bold text-body-lg text-on-background mt-0.5">{{ activity.name }}</h4>
											<p class="text-on-surface-variant text-xs">{{ activity.startDate|date('d/m/Y') }} - {{ activity.endDate|date('d/m/Y') }}</p>
										</div>
									</div>
								</div>
								<div class="space-y-xs">
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant">Resultado Final</span>
										<span class="font-bold text-secondary">{{ progress }}% de Éxito</span>
									</div>
									<div class="w-full h-1.5 bg-surface-variant rounded-full overflow-hidden">
										<div class="h-full bg-secondary rounded-full transition-all duration-500" style="width: {{ progress }}%;"></div>
									</div>
									<div class="grid grid-cols-2 gap-sm pt-xs">
										<div>
											<p class="font-label-bold text-[10px] text-on-surface-variant uppercase">Recaudado</p>
											<p class="text-body-md font-bold text-secondary">${{ activity.raisedAmount|number_format(2, '.', ',') }}</p>
										</div>
										<div>
											<p class="font-label-bold text-[10px] text-on-surface-variant uppercase">Meta Original</p>
											<p class="text-body-md font-bold text-on-background">${{ activity.goalAmount|number_format(2, '.', ',') }}</p>
										</div>
									</div>
								</div>
							</div>
							<div class="mt-md pt-xs border-t border-outline-variant flex items-center gap-xs">
								<a href="{{ path('app_actividades_detalle', {id: activity.id}) }}" class="h-8 px-md border border-outline text-on-surface-variant rounded-md font-label-bold text-xs hover:bg-surface-variant transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
									<span class="material-symbols-outlined text-sm">visibility</span> Ver Detalles
								</a>
							</div>
						</div>

					{% elseif activity.status == 'cancelled' %}
						<div data-card-status="cancelled" class="activity-card bg-surface-container-low border border-outline-variant opacity-75 grayscale-[0.3] rounded-xl p-md shadow-xs flex flex-col justify-between">
							<div>
								<div class="flex justify-between items-start mb-md">
									<div class="flex items-center gap-md">
										<div class="w-11 h-11 rounded-lg bg-error-container flex items-center justify-center text-on-error-container shrink-0">
											<span class="material-symbols-outlined text-xl">cancel</span>
										</div>
										<div>
											<span class="bg-error-container text-on-error-container text-[10px] px-xs py-[1px] rounded-full font-label-bold uppercase">Cancelada</span>
											<h4 class="font-bold text-body-lg text-on-background mt-0.5">{{ activity.name }}</h4>
											<p class="text-on-surface-variant text-xs">{{ activity.startDate|date('d/m/Y') }} - {{ activity.endDate|date('d/m/Y') }}</p>
										</div>
									</div>
								</div>
								<div>
									<p class="bg-surface p-sm rounded-lg border border-outline-variant text-xs text-on-surface-variant italic">
										{{ activity.description }}
									</p>
								</div>
							</div>
							<div class="mt-md pt-xs border-t border-outline-variant flex items-center gap-xs">
								<form method="post" action="{{ path('app_actividades_reactivar', {id: activity.id}) }}" class="inline-block">
									<button type="submit" class="h-8 px-md border border-outline text-on-surface-variant rounded-md font-label-bold text-xs hover:bg-surface-variant transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
										<span class="material-symbols-outlined text-sm">restart_alt</span> Reactivar
									</button>
								</form>
								<form method="post" action="{{ path('app_actividades_eliminar', {id: activity.id}) }}" class="inline-block" onsubmit="return confirm('¿Estás seguro de eliminar esta actividad?')">
									<button type="submit" class="h-8 px-md border border-error/40 text-error rounded-md font-label-bold text-xs hover:bg-error-container/30 transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
										<span class="material-symbols-outlined text-sm">delete</span> Eliminar
									</button>
								</form>
							</div>
						</div>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const tabBtns = document.querySelectorAll('.activity-tab-btn');
			const cards = document.querySelectorAll('.activity-card');
			const emptyMsg = document.getElementById('noActivitiesMessage');
			const grid = document.getElementById('activitiesGrid');

			if (!tabBtns.length) return;

			tabBtns.forEach(btn => {
				btn.addEventListener('click', function() {
					const targetStatus = this.getAttribute('data-status');

					tabBtns.forEach(b => {
						b.classList.remove('border-b-2', 'border-primary', 'text-primary', 'font-bold');
						b.classList.add('text-on-surface-variant');
					});

					this.classList.remove('text-on-surface-variant');
					this.classList.add('border-b-2', 'border-primary', 'text-primary', 'font-bold');

					let visibleCount = 0;
					cards.forEach(card => {
						const cardStatus = card.getAttribute('data-card-status');
						if (targetStatus === 'all' || cardStatus === targetStatus) {
							card.classList.remove('hidden');
							visibleCount++;
						} else {
							card.classList.add('hidden');
						}
					});

					if (emptyMsg && grid) {
						if (visibleCount === 0) {
							emptyMsg.classList.remove('hidden');
							grid.classList.add('hidden');
						} else {
							emptyMsg.classList.add('hidden');
							grid.classList.remove('hidden');
						}
					}
				});
			});

			const actModal = document.getElementById('newActivityModal');
			const closeActBtn = document.getElementById('closeActModalBtn');
			const cancelActBtn = document.getElementById('cancelActModalBtn');

			function openActModal() {
				if (actModal) actModal.classList.remove('hidden');
			}
			function closeActModal() {
				if (actModal) actModal.classList.add('hidden');
			}

			document.addEventListener('click', function(e) {
				const newActBtn = e.target.closest('[data-new-activity="true"]');
				if (newActBtn) {
					e.preventDefault();
					openActModal();
				}
			});

			if (closeActBtn) closeActBtn.addEventListener('click', closeActModal);
			if (cancelActBtn) cancelActBtn.addEventListener('click', closeActModal);
			if (actModal) {
				actModal.addEventListener('click', function(e) {
					if (e.target === actModal) closeActModal();
				});
			}

			// LOGICA PARA EDITAR ACTIVIDADES EN MODAL
			const editActModal = document.getElementById('editActivityModal');
			const editActForm = document.getElementById('editActivityForm');
			const closeEditActBtn = document.getElementById('closeEditActModalBtn');
			const cancelEditActBtn = document.getElementById('cancelEditActModalBtn');

			function closeEditActModal() {
				if (editActModal) editActModal.classList.add('hidden');
			}

			document.addEventListener('click', function(e) {
				const editActBtn = e.target.closest('[data-edit-activity="true"]');
				if (editActBtn) {
					e.preventDefault();
					const id = editActBtn.getAttribute('data-id');
					const name = editActBtn.getAttribute('data-name');
					const desc = editActBtn.getAttribute('data-description');
					const cat = editActBtn.getAttribute('data-category');
					const goal = editActBtn.getAttribute('data-goal');
					const start = editActBtn.getAttribute('data-start');
					const end = editActBtn.getAttribute('data-end');

					if (editActForm) {
						editActForm.action = '/actividades/' + id + '/editar';
						document.getElementById('editActName').value = name || '';
						document.getElementById('editActDescription').value = desc || '';
						document.getElementById('editActCategory').value = cat || 'recaudacion';
						document.getElementById('editActGoal').value = goal || '0.00';
						document.getElementById('editActStartDate').value = start || '';
						document.getElementById('editActEndDate').value = end || '';
					}

					if (editActModal) editActModal.classList.remove('hidden');
				}
			});

			if (closeEditActBtn) closeEditActBtn.addEventListener('click', closeEditActModal);
			if (cancelEditActBtn) cancelEditActBtn.addEventListener('click', closeEditActModal);
			if (editActModal) {
				editActModal.addEventListener('click', function(e) {
					if (e.target === editActModal) closeEditActModal();
				});
			}
		});
	</script>

	<!-- MODAL: NUEVA ACTIVIDAD -->
	<div id="newActivityModal" class="hidden fixed inset-0 bg-on-surface/50 backdrop-blur-sm z-[100] flex items-center justify-center p-md sm:p-lg overflow-y-auto">
		<div class="bg-white border border-outline-variant rounded-2xl shadow-2xl w-full max-w-xl max-h-[90vh] flex flex-col overflow-hidden animate-scale-up">
			<div class="p-lg bg-surface-container-low border-b border-outline-variant flex justify-between items-center">
				<div class="flex items-center gap-sm">
					<div class="w-9 h-9 rounded-lg bg-primary-container text-on-primary-container flex items-center justify-center font-bold">
						<span class="material-symbols-outlined text-xl">event</span>
					</div>
					<div>
						<h3 class="font-bold text-body-lg text-on-background">Crear Nueva Actividad</h3>
						<p class="text-xs text-on-surface-variant">Evento o campaña de recaudación</p>
					</div>
				</div>
				<button type="button" id="closeActModalBtn" class="p-xs text-on-surface-variant hover:text-error transition-colors rounded-full cursor-pointer">
					<span class="material-symbols-outlined text-xl">close</span>
				</button>
			</div>
			<form action="{{ path('app_actividades_nueva') }}" method="POST" class="flex flex-col flex-1 overflow-hidden">
				<input type="hidden" name="activity[_token]" value="{{ csrf_token('submit') }}"/>
				<div class="p-lg overflow-y-auto space-y-md flex-1">
					<div>
						<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Nombre de la Actividad</label>
						<input type="text" name="activity[name]" required placeholder="Ej. Venta de Empanadas" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md font-bold"/>
					</div>
					<div>
						<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Descripción</label>
						<textarea name="activity[description]" rows="2" placeholder="Detalles de la actividad..." class="w-full p-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm"></textarea>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Categoría</label>
							<select name="activity[category]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm">
								<option value="recaudacion" selected>Recaudación</option>
								<option value="mision">Misión</option>
								<option value="social">Social</option>
								<option value="juvenil">Juvenil</option>
								<option value="infantil">Infantil</option>
								<option value="musica">Música</option>
								<option value="construccion">Construcción</option>
								<option value="otro">Otro</option>
							</select>
						</div>
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Meta ($)</label>
							<input type="number" step="0.01" min="0" name="activity[goalAmount]" required placeholder="0.00" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-headline-sm font-data-mono"/>
						</div>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Fecha de Inicio</label>
							<input type="date" name="activity[startDate]" value="{{ 'now'|date('Y-m-d') }}" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md"/>
						</div>
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Fecha de Cierre</label>
							<input type="date" name="activity[endDate]" value="{{ 'now'|date('Y-m-d') }}" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md"/>
						</div>
					</div>
				</div>
				<div class="p-md bg-surface-container-low border-t border-outline-variant flex justify-center items-center gap-sm sm:gap-md">
					<button type="button" id="cancelActModalBtn" class="h-9 px-lg border border-outline text-on-surface-variant rounded-lg font-bold text-xs hover:bg-surface-variant cursor-pointer">Cancelar</button>
					<button type="submit" class="h-9 px-lg bg-primary text-on-primary rounded-lg font-bold text-xs hover:bg-primary-container cursor-pointer shadow-xs flex items-center gap-xs">
						<span class="material-symbols-outlined text-sm">save</span> Crear Actividad
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- MODAL: EDITAR ACTIVIDAD -->
	<div id="editActivityModal" class="hidden fixed inset-0 bg-on-surface/50 backdrop-blur-sm z-[100] flex items-center justify-center p-md sm:p-lg overflow-y-auto">
		<div class="bg-white border border-outline-variant rounded-2xl shadow-2xl w-full max-w-xl max-h-[90vh] flex flex-col overflow-hidden animate-scale-up">
			<div class="p-lg bg-surface-container-low border-b border-outline-variant flex justify-between items-center">
				<div class="flex items-center gap-sm">
					<div class="w-9 h-9 rounded-lg bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold">
						<span class="material-symbols-outlined text-xl">edit</span>
					</div>
					<div>
						<h3 class="font-bold text-body-lg text-on-background">Editar Actividad</h3>
						<p class="text-xs text-on-surface-variant">Modifica los detalles de la actividad</p>
					</div>
				</div>
				<button type="button" id="closeEditActModalBtn" class="p-xs text-on-surface-variant hover:text-error transition-colors rounded-full cursor-pointer">
					<span class="material-symbols-outlined text-xl">close</span>
				</button>
			</div>
			<form id="editActivityForm" action="" method="POST" class="flex flex-col flex-1 overflow-hidden">
				<input type="hidden" name="activity[_token]" value="{{ csrf_token('submit') }}"/>
				<div class="p-lg overflow-y-auto space-y-md flex-1">
					<div>
						<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Nombre de la Actividad</label>
						<input type="text" id="editActName" name="activity[name]" required class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md font-bold"/>
					</div>
					<div>
						<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Descripción</label>
						<textarea id="editActDescription" name="activity[description]" rows="2" class="w-full p-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm"></textarea>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Categoría</label>
							<select id="editActCategory" name="activity[category]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm">
								<option value="recaudacion">Recaudación</option>
								<option value="mision">Misión</option>
								<option value="social">Social</option>
								<option value="juvenil">Juvenil</option>
								<option value="infantil">Infantil</option>
								<option value="musica">Música</option>
								<option value="construccion">Construcción</option>
								<option value="otro">Otro</option>
							</select>
						</div>
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Meta ($)</label>
							<input type="number" step="0.01" min="0" id="editActGoal" name="activity[goalAmount]" required class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-headline-sm font-data-mono"/>
						</div>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Fecha de Inicio</label>
							<input type="date" id="editActStartDate" name="activity[startDate]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md"/>
						</div>
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Fecha de Cierre</label>
							<input type="date" id="editActEndDate" name="activity[endDate]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md"/>
						</div>
					</div>
				</div>
				<div class="p-md bg-surface-container-low border-t border-outline-variant flex justify-center items-center gap-sm sm:gap-md">
					<button type="button" id="cancelEditActModalBtn" class="h-9 px-lg border border-outline text-on-surface-variant rounded-lg font-bold text-xs hover:bg-surface-variant cursor-pointer">Cancelar</button>
					<button type="submit" class="h-9 px-lg bg-primary text-on-primary rounded-lg font-bold text-xs hover:bg-primary-container cursor-pointer shadow-xs flex items-center gap-xs">
						<span class="material-symbols-outlined text-sm">save</span> Guardar Cambios
					</button>
				</div>
			</form>
		</div>
	</div>
{% endblock %}
