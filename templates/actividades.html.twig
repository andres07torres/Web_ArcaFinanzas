{% extends 'base_dashboard.html.twig' %}

{% set active_menu = 'actividades' %}

{% block title %}FaithFinance - Actividades y Eventos{% endblock %}

{% block dashboard_content %}
	<div class="p-lg max-w-container-max mx-auto w-full">
		<div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
			<div>
				<nav class="flex items-center gap-xs text-on-surface-variant font-label-bold text-label-bold mb-xs">
					<span>Organización</span>
					<span class="material-symbols-outlined text-xs">chevron_right</span>
					<span class="text-primary">Actividades</span>
				</nav>
				<h1 class="font-headline-lg text-headline-lg text-on-background">Gestión de Eventos</h1>
				<p class="text-on-surface-variant font-body-md mt-xs">Rastree, gestione y cierre eventos de recaudación de fondos y actividades ministeriales.</p>
			</div>
			<a href="{{ path('app_actividades_nueva') }}" class="bg-primary text-on-primary px-xl py-md rounded-xl font-label-bold text-label-bold shadow-md hover:bg-primary-container transition-all flex items-center justify-center gap-sm">
				<span class="material-symbols-outlined text-base">add</span>
				Nueva Actividad
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-lg mb-xl">
			<div class="bg-surface border border-outline-variant rounded-xl p-lg shadow-sm">
				<div class="flex justify-between items-start mb-md">
					<span class="p-sm bg-secondary-container text-on-secondary-container rounded-lg material-symbols-outlined">trending_up</span>
					<span class="text-secondary font-label-bold text-label-bold">{{ active_count }} Activas</span>
				</div>
				<p class="font-label-bold text-label-bold text-on-surface-variant">Total Fondos Recaudados</p>
				<h3 class="font-headline-md text-headline-md text-on-background mt-xs">${{ total_raised|number_format(2, '.', ',') }}</h3>
			</div>
			<div class="bg-surface border border-outline-variant rounded-xl p-lg shadow-sm">
				<div class="flex justify-between items-start mb-md">
					<span class="p-sm bg-primary-fixed text-on-primary-fixed rounded-lg material-symbols-outlined">event</span>
					<span class="text-on-surface-variant font-label-bold text-label-bold">{{ active_count }} Activas</span>
				</div>
				<p class="font-label-bold text-label-bold text-on-surface-variant">Actividades en Curso</p>
				<h3 class="font-headline-md text-headline-md text-on-background mt-xs">{{ active_count }}</h3>
			</div>
			<div class="bg-surface border border-outline-variant rounded-xl p-lg shadow-sm">
				<div class="flex justify-between items-start mb-md">
					<span class="p-sm bg-tertiary-fixed text-on-tertiary-fixed rounded-lg material-symbols-outlined">account_balance</span>
					<span class="text-secondary font-label-bold text-label-bold">{{ finished_count }} Finalizadas</span>
				</div>
				<p class="font-label-bold text-label-bold text-on-surface-variant">Actividades Finalizadas</p>
				<h3 class="font-headline-md text-headline-md text-on-background mt-xs">{{ finished_count }}</h3>
			</div>
		</div>

		<div class="flex items-center gap-md border-b border-outline-variant mb-lg overflow-x-auto pb-xs custom-scrollbar">
			<button class="px-lg py-md border-b-2 border-primary text-primary font-bold whitespace-nowrap">Todas las Actividades</button>
			<button class="px-lg py-md text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap">Activas</button>
			<button class="px-lg py-md text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap">Finalizadas</button>
			<button class="px-lg py-md text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap">Canceladas</button>
		</div>

		{% if activities|length == 0 %}
			<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-xl shadow-sm text-center">
				<span class="material-symbols-outlined text-6xl text-on-surface-variant opacity-40">event_available</span>
				<h3 class="font-headline-sm text-headline-sm text-on-background mt-md">No hay actividades registradas</h3>
				<p class="text-on-surface-variant font-body-sm mt-xs mb-lg">Comienza creando tu primera actividad o evento.</p>
				<a href="{{ path('app_actividades_nueva') }}" class="bg-primary text-on-primary px-xl py-md rounded-xl font-label-bold text-label-bold shadow-md hover:bg-primary-container transition-all inline-flex items-center gap-sm">
					<span class="material-symbols-outlined text-base">add</span>
					Crear Primera Actividad
				</a>
			</div>
		{% else %}
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-lg">
				{% for activity in activities %}
					{% set progress = activity.goalAmount > 0 ? ((activity.raisedAmount / activity.goalAmount) * 100)|round(0) : 0 %}

					{% if activity.status == 'active' %}
						<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm hover:shadow-md transition-shadow flex flex-col">
							<div class="flex justify-between items-start mb-lg">
								<div class="flex gap-md">
									<div class="w-16 h-16 rounded-xl bg-secondary-container flex items-center justify-center text-on-secondary-container">
										<span class="material-symbols-outlined text-3xl">festival</span>
									</div>
									<div>
										<span class="bg-secondary-container text-on-secondary-container text-[10px] px-sm py-[2px] rounded-full font-label-bold uppercase tracking-wider">Activa</span>
										<h4 class="font-headline-sm text-headline-sm text-on-background mt-xs">{{ activity.name }}</h4>
										<p class="text-on-surface-variant font-body-sm">{{ activity.startDate|date('d/m/Y') }} - {{ activity.endDate|date('d/m/Y') }}</p>
									</div>
								</div>
							</div>
							<div class="flex-1 space-y-md">
								<div class="flex justify-between items-center text-body-sm">
									<span class="text-on-surface-variant">Progreso hacia la Meta</span>
									<span class="font-bold text-on-background">{{ progress }}%</span>
								</div>
								<div class="w-full h-2 bg-surface-variant rounded-full overflow-hidden">
									<div class="h-full bg-secondary w-[{{ progress }}%] rounded-full transition-all duration-500"></div>
								</div>
								<div class="grid grid-cols-2 gap-md pt-md">
									<div>
										<p class="font-label-bold text-label-bold text-on-surface-variant uppercase">Recaudaciones Actuales</p>
										<p class="text-headline-sm font-bold text-secondary">${{ activity.raisedAmount|number_format(2, '.', ',') }}</p>
									</div>
									<div>
										<p class="font-label-bold text-label-bold text-on-surface-variant uppercase">Meta de Recaudación</p>
										<p class="text-headline-sm font-bold text-on-background">${{ activity.goalAmount|number_format(2, '.', ',') }}</p>
									</div>
								</div>
							</div>
							<div class="mt-xl flex items-center gap-sm">
								<a href="{{ path('app_actividades_editar', {id: activity.id}) }}" class="flex-1 flex items-center justify-center gap-xs py-md px-md rounded-xl border border-secondary text-secondary font-label-bold text-label-bold hover:bg-secondary hover:text-on-secondary transition-all">
									<span class="material-symbols-outlined text-base">edit</span> Editar
								</a>
								<form method="post" action="{{ path('app_actividades_cerrar', {id: activity.id}) }}" class="flex-1">
									<button type="submit" class="w-full flex items-center justify-center gap-xs py-md px-lg rounded-xl bg-primary text-on-primary font-label-bold text-label-bold hover:bg-primary-container transition-all">
										Cerrar
									</button>
								</form>
							</div>
						</div>

					{% elseif activity.status == 'finished' %}
						<div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm hover:shadow-md transition-shadow flex flex-col">
							<div class="flex justify-between items-start mb-lg">
								<div class="flex gap-md">
									<div class="w-16 h-16 rounded-xl bg-surface-variant flex items-center justify-center text-on-surface-variant">
										<span class="material-symbols-outlined text-3xl">volunteer_activism</span>
									</div>
									<div>
										<span class="bg-surface-variant text-on-surface-variant text-[10px] px-sm py-[2px] rounded-full font-label-bold uppercase tracking-wider">Finalizada</span>
										<h4 class="font-headline-sm text-headline-sm text-on-background mt-xs">{{ activity.name }}</h4>
										<p class="text-on-surface-variant font-body-sm">{{ activity.startDate|date('d/m/Y') }} - {{ activity.endDate|date('d/m/Y') }}</p>
									</div>
								</div>
							</div>
							<div class="flex-1 space-y-md">
								<div class="flex justify-between items-center text-body-sm">
									<span class="text-on-surface-variant">Resultado Final</span>
									<span class="font-bold text-on-secondary-container">{{ progress }}% de Éxito</span>
								</div>
								<div class="w-full h-2 bg-surface-variant rounded-full overflow-hidden">
									<div class="h-full bg-secondary w-full rounded-full transition-all duration-500"></div>
								</div>
								<div class="grid grid-cols-2 gap-md pt-md">
									<div>
										<p class="font-label-bold text-label-bold text-on-surface-variant uppercase">Recaudado</p>
										<p class="text-headline-sm font-bold text-secondary">${{ activity.raisedAmount|number_format(2, '.', ',') }}</p>
									</div>
									<div>
										<p class="font-label-bold text-label-bold text-on-surface-variant uppercase">Meta Original</p>
										<p class="text-headline-sm font-bold text-on-background">${{ activity.goalAmount|number_format(2, '.', ',') }}</p>
									</div>
								</div>
							</div>
							<div class="mt-xl flex items-center gap-sm">
								<button class="flex-1 flex items-center justify-center gap-xs py-md px-md rounded-xl border border-outline text-on-surface-variant font-label-bold text-label-bold hover:bg-surface-variant transition-all">
									<span class="material-symbols-outlined text-base">visibility</span> Ver Detalles
								</button>
							</div>
						</div>

					{% elseif activity.status == 'cancelled' %}
						<div class="bg-surface-container-low border border-outline-variant opacity-75 grayscale-[0.3] rounded-xl p-lg shadow-sm flex flex-col">
							<div class="flex justify-between items-start mb-lg">
								<div class="flex gap-md">
									<div class="w-16 h-16 rounded-xl bg-error-container flex items-center justify-center text-on-error-container">
										<span class="material-symbols-outlined text-3xl">cancel</span>
									</div>
									<div>
										<span class="bg-error-container text-on-error-container text-[10px] px-sm py-[2px] rounded-full font-label-bold uppercase tracking-wider">Cancelada</span>
										<h4 class="font-headline-sm text-headline-sm text-on-background mt-xs">{{ activity.name }}</h4>
										<p class="text-on-surface-variant font-body-sm">{{ activity.startDate|date('d/m/Y') }} - {{ activity.endDate|date('d/m/Y') }}</p>
									</div>
								</div>
							</div>
							<div class="flex-1">
								<p class="bg-surface p-md rounded-lg border border-outline-variant text-body-sm text-on-surface-variant italic">
									{{ activity.description }}
								</p>
							</div>
							<div class="mt-xl flex items-center gap-sm">
								<form method="post" action="{{ path('app_actividades_reactivar', {id: activity.id}) }}" class="flex-1">
									<button type="submit" class="w-full flex items-center justify-center gap-xs py-md px-md rounded-xl border border-outline text-on-surface-variant font-label-bold text-label-bold hover:bg-surface-variant transition-all">
										<span class="material-symbols-outlined text-base">restart_alt</span> Reactivar
									</button>
								</form>
								<form method="post" action="{{ path('app_actividades_eliminar', {id: activity.id}) }}" class="flex-1" onsubmit="return confirm('¿Estás seguro de eliminar esta actividad?')">
									<button type="submit" class="w-full flex items-center justify-center gap-xs py-md px-md rounded-xl border border-outline text-on-surface-variant font-label-bold text-label-bold hover:bg-surface-variant transition-all">
										<span class="material-symbols-outlined text-base">delete</span> Eliminar
									</button>
								</form>
							</div>
						</div>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}
	</div>
{% endblock %}
