{% block javascripts %}
	{{ parent() }}
	<script>
		function switchTab(type) {
			const incomeTab = document.getElementById('tab-income');
			const expenseTab = document.getElementById('tab-expense');
			const submitBtn = document.getElementById('submit-text');
			const submitIcon = document.getElementById('submit-icon');
			const contributorSection = document.getElementById('contributor-section');

			if (type === 'income') {
				incomeTab.classList.add('tab-active');
				incomeTab.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-low');
				expenseTab.classList.remove('tab-active');
				expenseTab.classList.add('text-on-surface-variant', 'hover:bg-surface-container-low');
				submitBtn.innerText = 'Registrar Ingreso';
				submitIcon.innerText = 'save';
				contributorSection.classList.remove('hidden');
			} else {
				expenseTab.classList.add('tab-active');
				expenseTab.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-low');
				incomeTab.classList.remove('tab-active');
				incomeTab.classList.add('text-on-surface-variant', 'hover:bg-surface-container-low');
				submitBtn.innerText = 'Registrar Gasto';
				submitIcon.innerText = 'receipt_long';
				contributorSection.classList.add('hidden');
			}
		}

		const activitySelect = document.getElementById('activity-select');
		const netProfitDisplay = document.getElementById('net-profit-value');
		const activityNameDisplay = document.getElementById('selected-activity-name');

		activitySelect.addEventListener('change', (e) => {
			const value = e.target.value;
			const text = e.target.options[e.target.selectedIndex].text;
			netProfitDisplay.classList.add('opacity-50');
			setTimeout(() => {
				activityNameDisplay.innerText = text;
				if (value === '0') {
					netProfitDisplay.innerText = '$14,250.00';
				} else {
					const randomValue = (Math.random() * 5000 + parseInt(value)).toFixed(2);
					netProfitDisplay.innerText = '$' + parseFloat(randomValue).toLocaleString();
				}
				netProfitDisplay.classList.remove('opacity-50');
			}, 300);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'n' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
				e.preventDefault();
				document.querySelector('input[type="number"]').focus();
			}
		});
	</script>
{% endblock %}
