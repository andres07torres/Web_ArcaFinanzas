{% extends 'base.html.twig' %}

{% block title %}FaithFinance{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
	<script id="tailwind-config">
		tailwind.config = {
			darkMode: "class",
			theme: {
				extend: {
					"colors": {
						"surface-variant": "#e0e3e5",
						"on-surface-variant": "#444651",
						"on-primary": "#ffffff",
						"surface-dim": "#d8dadc",
						"on-secondary-fixed-variant": "#005049",
						"on-primary-fixed-variant": "#264191",
						"outline-variant": "#c5c5d3",
						"secondary": "#006a61",
						"background": "#f7f9fb",
						"on-tertiary-container": "#a1a4ff",
						"tertiary-fixed-dim": "#c0c1ff",
						"on-background": "#191c1e",
						"secondary-fixed": "#89f5e7",
						"primary-fixed-dim": "#b6c4ff",
						"surface-container-lowest": "#ffffff",
						"on-primary-container": "#90a8ff",
						"on-tertiary-fixed": "#07006c",
						"on-tertiary-fixed-variant": "#2f2ebe",
						"surface-bright": "#f7f9fb",
						"surface-container-highest": "#e0e3e5",
						"inverse-surface": "#2d3133",
						"error-container": "#ffdad6",
						"inverse-on-surface": "#eff1f3",
						"on-secondary": "#ffffff",
						"outline": "#757682",
						"on-tertiary": "#ffffff",
						"surface-container-high": "#e6e8ea",
						"primary": "#00236f",
						"inverse-primary": "#b6c4ff",
						"primary-container": "#1e3a8a",
						"surface-tint": "#4059aa",
						"surface-container-low": "#f2f4f6",
						"on-error-container": "#93000a",
						"on-secondary-fixed": "#00201d",
						"on-primary-fixed": "#00164e",
						"on-secondary-container": "#006f66",
						"tertiary-fixed": "#e1e0ff",
						"surface-container": "#eceef0",
						"secondary-fixed-dim": "#6bd8cb",
						"surface": "#f7f9fb",
						"secondary-container": "#86f2e4",
						"primary-fixed": "#dce1ff",
						"on-error": "#ffffff",
						"on-surface": "#191c1e",
						"tertiary": "#0d0097",
						"tertiary-container": "#2724b8",
						"error": "#ba1a1a"
					},
					"borderRadius": {
						"DEFAULT": "0.125rem",
						"lg": "0.25rem",
						"xl": "0.5rem",
						"full": "0.75rem"
					},
					"spacing": {
						"md": "16px",
						"xs": "4px",
						"gutter": "24px",
						"lg": "24px",
						"xl": "32px",
						"sm": "8px",
						"base": "4px",
						"container-max": "1280px"
					},
					"fontFamily": {
						"body-lg": ["Inter"],
						"headline-lg-mobile": ["Inter"],
						"headline-md": ["Inter"],
						"body-md": ["Inter"],
						"data-mono": ["Inter"],
						"body-sm": ["Inter"],
						"headline-lg": ["Inter"],
						"headline-sm": ["Inter"],
						"label-bold": ["Inter"]
					},
					"fontSize": {
						"body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
						"headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
						"headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
						"body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
						"data-mono": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
						"body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
						"headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
						"headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
						"label-bold": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}]
					}
				},
			},
		}
	</script>
	<style>
		.material-symbols-outlined {
			font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
			display: inline-block;
			line-height: 1;
			text-transform: none;
			letter-spacing: normal;
			word-wrap: normal;
			white-space: nowrap;
			direction: ltr;
		}
	</style>
	{% block dashboard_stylesheets %}{% endblock %}
{% endblock %}

{% block body_class %}{% endblock %}

{% block body %}
	{% set active_menu = active_menu|default('dashboard') %}

	<div id="mobileSidebarBackdrop" class="hidden fixed inset-0 bg-black/60 z-40 lg:hidden backdrop-blur-xs transition-opacity"></div>

	<aside class="hidden lg:flex fixed left-0 top-0 h-full w-64 flex-col py-lg bg-surface-container-low border-r border-outline-variant z-50 shadow-2xl lg:shadow-none">
		<div class="px-lg mb-xl flex items-start justify-between">
			<div>
				<h2 class="font-headline-md text-headline-md text-primary">Comunidad</h2>
				<p class="font-label-bold text-label-bold text-on-surface-variant opacity-70">Portal del {{ app.user ? app.user.displayRole : 'Tesorero' }}</p>
			</div>
			<button type="button" id="mobileSidebarClose" class="lg:hidden p-xs text-on-surface-variant hover:text-error hover:bg-surface-variant rounded-full transition-colors cursor-pointer" title="Cerrar Menú">
				<span class="material-symbols-outlined text-2xl">close</span>
			</button>
		</div>
		<nav class="flex-1 space-y-1">
			<a class="flex items-center {{ active_menu == 'dashboard' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl mx-md p-md transition-all group" href="{{ path('app_dashboard') }}">
				<span class="material-symbols-outlined text-[18px] w-6 text-center mr-md group-hover:translate-x-1 duration-300">dashboard</span>
				<span class="font-label-bold text-label-bold">Tablero</span>
			</a>
			<a class="flex items-center {{ active_menu == 'actividades' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl mx-md p-md transition-all group" href="{{ path('app_actividades') }}">
				<span class="material-symbols-outlined text-[18px] w-6 text-center mr-md group-hover:translate-x-1 duration-300">event_available</span>
				<span class="font-label-bold text-label-bold">Actividades</span>
			</a>
			<a class="flex items-center {{ active_menu == 'caja' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl mx-md p-md transition-all group" href="{{ path('app_caja') }}">
				<span class="material-symbols-outlined text-[18px] w-6 text-center mr-md group-hover:translate-x-1 duration-300">account_balance_wallet</span>
				<span class="font-label-bold text-label-bold">Control de Caja</span>
			</a>
			<a class="flex items-center {{ active_menu == 'directorio' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl mx-md p-md transition-all group" href="{{ path('app_directorio') }}">
				<span class="material-symbols-outlined text-[18px] w-6 text-center mr-md group-hover:translate-x-1 duration-300">group</span>
				<span class="font-label-bold text-label-bold">Directorio</span>
			</a>
			<a class="flex items-center {{ active_menu == 'reportes' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl mx-md p-md transition-all group" href="{{ path('app_reportes') }}">
				<span class="material-symbols-outlined text-[18px] w-6 text-center mr-md group-hover:translate-x-1 duration-300">assessment</span>
				<span class="font-label-bold text-label-bold">Informes</span>
			</a>
		</nav>
		<div class="px-md mt-auto pt-lg border-t border-outline-variant space-y-1">

			<a class="flex items-center {{ active_menu == 'configuracion' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl p-md transition-all" href="{{ path('app_configuracion') }}">
				<span class="material-symbols-outlined mr-md">person</span>
				<span class="font-label-bold text-label-bold">Mi Perfil</span>
			</a>
			<a class="flex items-center {{ active_menu == 'ayuda' ? 'bg-secondary-container text-on-secondary-container' : 'text-on-surface-variant hover:bg-surface-variant' }} rounded-xl p-md transition-all" href="{{ path('app_ayuda') }}">
				<span class="material-symbols-outlined mr-md">help</span>
				<span class="font-label-bold text-label-bold">Centro de Ayuda</span>
			</a>
			<a class="flex items-center text-on-surface-variant hover:bg-surface-variant rounded-xl p-md transition-all" href="{{ path('app_logout') }}">
				<span class="material-symbols-outlined mr-md">logout</span>
				<span class="font-label-bold text-label-bold">Cerrar Sesión</span>
			</a>
		</div>
	</aside>

	<main class="lg:ml-64 min-h-screen flex flex-col pb-20 lg:pb-0">
		<header class="sticky top-0 w-full z-40 flex justify-between items-center px-lg h-16 bg-surface border-b border-outline-variant shadow-sm">
			<div class="flex items-center gap-md">
				<button type="button" id="mobileSidebarToggle" class="lg:hidden p-xs text-on-surface-variant hover:bg-surface-container-low rounded-lg transition-colors cursor-pointer" title="Menú">
					<span class="material-symbols-outlined text-2xl">menu</span>
				</button>
				<span class="font-headline-sm text-headline-sm font-bold text-primary">Arca Finanzas</span>
				<div class="relative hidden sm:flex items-center ml-md lg:ml-xl" id="globalSearchWrapper">
					<div class="flex items-center bg-surface-container-low rounded-full px-md py-1 border border-outline-variant focus-within:ring-2 focus-within:ring-primary focus-within:border-primary transition-all">
						<span class="material-symbols-outlined text-on-surface-variant text-sm mr-xs">search</span>
						<input id="globalSearchInput" class="bg-transparent border-none focus:ring-0 text-body-sm w-48 lg:w-64 outline-none" placeholder="Buscar en Arca Finanzas..." type="text" autocomplete="off"/>
						<kbd class="hidden lg:inline-block px-1.5 py-0.5 text-[10px] font-semibold text-on-surface-variant bg-surface-container border border-outline-variant rounded">Ctrl K</kbd>
					</div>
					<div id="globalSearchResultsPopover" class="hidden absolute top-full left-0 mt-2 w-80 sm:w-96 lg:w-[420px] bg-white border border-outline-variant rounded-2xl shadow-2xl z-50 overflow-hidden">
						<div id="globalSearchResultsContent" class="max-h-96 overflow-y-auto divide-y divide-outline-variant">
						</div>
					</div>
				</div>
			</div>
			<div class="flex items-center gap-md">
				<a href="{{ path('app_caja_nueva') }}" class="hidden sm:flex items-center bg-primary text-on-primary px-lg py-sm rounded-full font-label-bold text-label-bold cursor-pointer active:scale-95 hover:bg-primary-container transition-all">
					Entrada Rápida
				</a>
				<div class="relative" id="notificationsDropdownWrapper">
					<button id="notificationsToggleBtn" type="button" title="Notificaciones en tiempo real" class="p-sm rounded-full hover:bg-surface-container-low transition-colors relative cursor-pointer focus:outline-none">
						<span class="material-symbols-outlined text-on-surface-variant">notifications</span>
						<span id="notifBadge" class="absolute top-1 right-1 w-2.5 h-2.5 bg-error rounded-full ring-2 ring-surface"></span>
					</button>
					<div id="notificationsMenu" class="hidden fixed sm:absolute left-3 right-3 sm:left-auto sm:right-0 top-16 sm:top-full mt-1 sm:mt-2 w-auto sm:w-96 bg-white border border-outline-variant rounded-2xl shadow-2xl z-50 overflow-hidden max-w-[calc(100vw-24px)]">
						<div class="p-md bg-surface-container-low border-b border-outline-variant flex justify-between items-center gap-xs">
							<div class="flex items-center gap-xs min-w-0">
								<span class="material-symbols-outlined text-primary text-sm shrink-0">notifications_active</span>
								<span class="font-headline-sm text-xs sm:text-sm font-bold text-primary truncate">Notificaciones</span>
							</div>
							<div class="flex items-center gap-xs">
								<button id="clearNotifBtn" type="button" class="px-2 py-1 text-[11px] font-bold text-primary hover:bg-primary/10 rounded-md transition-colors flex items-center gap-0.5 cursor-pointer" title="Marcar todas como vistas y limpiar">
									<span class="material-symbols-outlined text-xs">done_all</span> Limpiar
								</button>
								<span id="notifCountTag" class="px-2 py-0.5 bg-primary-container text-on-primary-container rounded-full text-[10px] font-bold whitespace-nowrap shrink-0">Cargando...</span>
							</div>
						</div>
						<div id="notifList" class="max-h-80 overflow-y-auto divide-y divide-outline-variant">
							<div class="p-lg text-center text-body-sm text-on-surface-variant">
								Cargando actividad reciente...
							</div>
						</div>
						<div class="p-sm bg-surface-container-low border-t border-outline-variant flex justify-between items-center text-xs">
							<button id="clearNotifBtnFooter" type="button" class="font-bold text-on-surface-variant hover:text-error transition-colors flex items-center gap-xs cursor-pointer">
								<span class="material-symbols-outlined text-xs">delete_sweep</span> Marcar vistas
							</button>
							<a href="{{ path('app_reportes') }}" class="font-bold text-primary hover:underline flex items-center gap-xs">
								Ver Auditoría <span class="material-symbols-outlined text-xs">arrow_forward</span>
							</a>
						</div>
					</div>
				</div>
				<a href="{{ path('app_configuracion') }}" title="Configuración de usuario" class="p-sm rounded-full hover:bg-surface-container-low transition-colors">
					<span class="material-symbols-outlined text-on-surface-variant">settings</span>
				</a>
				<a href="{{ path('app_configuracion') }}" class="flex items-center gap-sm group">
					<div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-xs border border-outline-variant shadow-sm group-hover:ring-2 group-hover:ring-primary transition-all" title="{{ app.user ? app.user.fullName : 'Usuario' }}">
						{{ app.user ? app.user.getInitials() : 'U' }}
					</div>
					{% if app.user and app.user.fullName %}
						<span class="hidden xl:inline-block font-label-bold text-label-bold text-on-surface-variant group-hover:text-primary transition-colors">{{ app.user.fullName }}</span>
					{% endif %}
				</a>
			</div>
		</header>

		{% for message in app.flashes('success') %}
			<div class="mx-auto w-full max-w-container-max px-lg pt-lg">
				<div class="bg-secondary-container/30 text-on-secondary-container border border-secondary/20 px-lg py-md rounded-xl flex items-center gap-md">
					<span class="material-symbols-outlined">check_circle</span>
					<span class="font-body-sm">{{ message }}</span>
				</div>
			</div>
		{% endfor %}

		{% block dashboard_content %}{% endblock %}
	</main>

	<nav class="lg:hidden fixed bottom-0 left-0 w-full bg-surface-container-highest border-t border-outline-variant flex justify-around items-center h-16 z-50 shadow-lg">
		<a class="flex flex-col items-center gap-1 {{ active_menu == 'dashboard' ? 'text-primary' : 'text-on-surface-variant' }}" href="{{ path('app_dashboard') }}">
			<span class="material-symbols-outlined" {{ active_menu == 'dashboard' ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>dashboard</span>
			<span class="text-[10px] font-label-bold">Inicio</span>
		</a>
		<a class="flex flex-col items-center gap-1 {{ active_menu == 'actividades' ? 'text-primary' : 'text-on-surface-variant' }}" href="{{ path('app_actividades') }}">
			<span class="material-symbols-outlined" {{ active_menu == 'actividades' ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>event_available</span>
			<span class="text-[10px] font-label-bold">Eventos</span>
		</a>
		<a class="flex flex-col items-center gap-1 {{ active_menu == 'caja' ? 'text-primary' : 'text-on-surface-variant' }}" href="{{ path('app_caja') }}">
			<span class="material-symbols-outlined" {{ active_menu == 'caja' ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>account_balance_wallet</span>
			<span class="text-[10px] font-label-bold">Caja</span>
		</a>
		<a class="flex flex-col items-center gap-1 {{ active_menu == 'directorio' ? 'text-primary' : 'text-on-surface-variant' }}" href="{{ path('app_directorio') }}">
			<span class="material-symbols-outlined" {{ active_menu == 'directorio' ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>group</span>
			<span class="text-[10px] font-label-bold">Directorio</span>
		</a>
				<a class="flex flex-col items-center gap-1 {{ active_menu == 'reportes' ? 'text-primary' : 'text-on-surface-variant' }}" href="{{ path('app_reportes') }}">
					<span class="material-symbols-outlined" {{ active_menu == 'reportes' ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>assessment</span>
					<span class="text-[10px] font-label-bold">Informes</span>
				</a>
				<a class="flex flex-col items-center gap-1 {{ active_menu == 'configuracion' ? 'text-primary' : 'text-on-surface-variant' }}" href="{{ path('app_configuracion') }}">
					<span class="material-symbols-outlined" {{ active_menu == 'configuracion' ? 'style="font-variation-settings: \'FILL\' 1;"' : '' }}>person</span>
					<span class="text-[10px] font-label-bold">Perfil</span>
				</a>
				<a class="flex flex-col items-center gap-1 text-on-surface-variant hover:bg-surface-variant rounded-xl p-md transition-all" href="{{ path('app_logout') }}">
					<span class="material-symbols-outlined">logout</span>
					<span class="text-[10px] font-label-bold">Salir</span>
				</a>
			</nav>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const toggleBtn = document.getElementById('notificationsToggleBtn');
			const menu = document.getElementById('notificationsMenu');
			const notifList = document.getElementById('notifList');
			const notifCountTag = document.getElementById('notifCountTag');
			const notifBadge = document.getElementById('notifBadge');
			const clearNotifBtn = document.getElementById('clearNotifBtn');
			const clearNotifBtnFooter = document.getElementById('clearNotifBtnFooter');

			if (!toggleBtn || !menu) return;

			function clearNotifications() {
				fetch('{{ path("app_notificaciones_limpiar") }}', {
					method: 'POST',
					headers: {
						'X-Requested-With': 'XMLHttpRequest'
					}
				})
				.then(r => r.json())
				.then(data => {
					if (notifCountTag) notifCountTag.textContent = '0 nuevas';
					if (notifBadge) notifBadge.classList.add('hidden');
					// Ya no eliminamos la lista, la mantenemos visible para consultas
				})
				.catch(err => console.error('Error al limpiar notificaciones:', err));
			}

			if (clearNotifBtn) clearNotifBtn.addEventListener('click', clearNotifications);
			if (clearNotifBtnFooter) clearNotifBtnFooter.addEventListener('click', clearNotifications);

			function fetchNotifications() {
				fetch('{{ path("app_notificaciones_api") }}')
					.then(r => r.json())
					.then(data => {
						if (!data || !data.items) return;
						if (notifCountTag) notifCountTag.textContent = data.count + ' recientes';
						if (notifBadge) {
							if (data.count > 0) {
								notifBadge.classList.remove('hidden');
							} else {
								notifBadge.classList.add('hidden');
							}
						}

						if (data.items.length === 0) {
							notifList.innerHTML = '<div class="p-lg text-center text-body-sm text-on-surface-variant">No hay actividad reciente.</div>';
							return;
						}

						notifList.innerHTML = data.items.map(item => `
							<a href="${item.url}" class="p-md flex items-start gap-md hover:bg-surface-container-low transition-colors group block">
								<div class="p-xs rounded-lg bg-surface-container ${item.color}">
									<span class="material-symbols-outlined text-[20px]">${item.icon}</span>
								</div>
								<div class="flex-1 min-w-0">
									<div class="flex justify-between items-center mb-xs">
										<span class="font-label-bold text-xs text-on-background font-bold truncate">${item.title}</span>
										<span class="text-[10px] text-on-surface-variant whitespace-nowrap ml-xs">${item.date}</span>
									</div>
									<p class="text-xs text-on-surface-variant truncate">${item.message}</p>
								</div>
							</a>
						`).join('');
					})
					.catch(err => {
						console.error('Error al cargar notificaciones:', err);
					});
			}

			toggleBtn.addEventListener('click', function(e) {
				e.stopPropagation();
				const isHidden = menu.classList.contains('hidden');
				if (isHidden) {
					menu.classList.remove('hidden');
					fetchNotifications();
				} else {
					menu.classList.add('hidden');
				}
			});

			document.addEventListener('click', function(e) {
				if (menu && !menu.contains(e.target) && !toggleBtn.contains(e.target)) {
					menu.classList.add('hidden');
				}
			});

			const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
			const mobileSidebarClose = document.getElementById('mobileSidebarClose');
			const mobileSidebarBackdrop = document.getElementById('mobileSidebarBackdrop');
			const sidebar = document.querySelector('aside');

			function openMobileSidebar() {
				if (sidebar) {
					sidebar.classList.remove('hidden');
					sidebar.classList.add('flex');
				}
				if (mobileSidebarBackdrop) {
					mobileSidebarBackdrop.classList.remove('hidden');
				}
			}

			function closeMobileSidebar() {
				if (sidebar) {
					sidebar.classList.add('hidden');
					sidebar.classList.remove('flex');
				}
				if (mobileSidebarBackdrop) {
					mobileSidebarBackdrop.classList.add('hidden');
				}
			}

			if (mobileSidebarToggle) {
				mobileSidebarToggle.addEventListener('click', function(e) {
					e.stopPropagation();
					if (sidebar && sidebar.classList.contains('hidden')) {
						openMobileSidebar();
					} else {
						closeMobileSidebar();
					}
				});
			}

			if (mobileSidebarClose) {
				mobileSidebarClose.addEventListener('click', closeMobileSidebar);
			}

			if (mobileSidebarBackdrop) {
				mobileSidebarBackdrop.addEventListener('click', closeMobileSidebar);
			}

			// Búsqueda Global en tiempo real
			const searchInput = document.getElementById('globalSearchInput');
			const searchWrapper = document.getElementById('globalSearchWrapper');
			const searchPopover = document.getElementById('globalSearchResultsPopover');
			const searchContent = document.getElementById('globalSearchResultsContent');
			let searchDebounceTimer = null;

			if (searchInput && searchPopover && searchContent && searchWrapper) {
				document.addEventListener('keydown', function(e) {
					if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
						e.preventDefault();
						searchInput.focus();
					}
				});

				searchInput.addEventListener('input', function() {
					clearTimeout(searchDebounceTimer);
					const q = searchInput.value.trim();

					if (q.length < 2) {
						searchPopover.classList.add('hidden');
						return;
					}

					searchDebounceTimer = setTimeout(() => {
						fetch('{{ path("app_buscar_api") }}?q=' + encodeURIComponent(q))
							.then(r => r.json())
							.then(data => {
								if (!data.results || data.results.length === 0) {
									searchContent.innerHTML = `
										<div class="p-xl text-center text-on-surface-variant">
											<span class="material-symbols-outlined text-3xl mb-xs block opacity-50">search_off</span>
											<p class="font-body-sm font-semibold">Sin resultados para "${data.query}"</p>
											<p class="text-xs text-on-surface-variant mt-xs">Intenta buscando por nombre, descripción o categoría.</p>
										</div>
									`;
								} else {
									searchContent.innerHTML = `
										<div class="p-xs bg-surface-container-low font-label-bold text-[11px] text-on-surface-variant uppercase px-md py-xs border-b border-outline-variant flex justify-between">
											<span>Coincidencias encontradas</span>
											<span class="text-primary font-bold">${data.total} resultados</span>
										</div>
										${data.results.map(item => `
											<a href="${item.url}" class="p-md flex items-center gap-md hover:bg-surface-container-low transition-colors block group">
												<div class="p-xs rounded-xl ${item.icon_bg} shadow-xs">
													<span class="material-symbols-outlined text-[20px]">${item.icon}</span>
												</div>
												<div class="flex-1 min-w-0">
													<div class="flex items-center justify-between">
														<h4 class="text-xs font-bold text-on-background group-hover:text-primary transition-colors truncate">${item.title}</h4>
														<span class="text-[10px] text-on-surface-variant font-medium ml-xs">${item.date}</span>
													</div>
													<div class="flex items-center justify-between mt-0.5">
														<p class="text-xs text-on-surface-variant truncate">${item.subtitle}</p>
														<span class="text-[9px] font-bold text-outline uppercase px-1.5 py-0.5 bg-surface-container rounded">${item.category}</span>
													</div>
												</div>
											</a>
										`).join('')}
									`;
								}
								searchPopover.classList.remove('hidden');
							})
							.catch(err => {
								console.error('Error al realizar búsqueda:', err);
							});
					}, 250);
				});

				document.addEventListener('click', function(e) {
					if (!searchWrapper.contains(e.target)) {
						searchPopover.classList.add('hidden');
					}
				});
			}

			fetchNotifications();
		});
	</script>

	<!-- MODAL: REGISTRAR TRANSACCIÓN (ENTRADA RÁPIDA) -->
	<div id="quickTransactionModal" class="hidden fixed inset-0 bg-on-surface/50 backdrop-blur-sm z-[100] flex items-center justify-center p-md sm:p-lg overflow-y-auto">
		<div class="bg-white border border-outline-variant rounded-2xl shadow-2xl w-full max-w-xl max-h-[90vh] flex flex-col overflow-hidden animate-scale-up">
			<div class="p-lg bg-surface-container-low border-b border-outline-variant flex justify-between items-center">
				<div class="flex items-center gap-sm">
					<div class="w-9 h-9 rounded-lg bg-primary-container text-on-primary-container flex items-center justify-center font-bold">
						<span class="material-symbols-outlined text-xl">receipt_long</span>
					</div>
					<div>
						<h3 class="font-bold text-body-lg text-on-background">Registrar Nueva Transacción</h3>
						<p class="text-xs text-on-surface-variant">Ingreso o Gasto de Caja</p>
					</div>
				</div>
				<button type="button" id="closeTxModalBtn" class="p-xs text-on-surface-variant hover:text-error transition-colors rounded-full cursor-pointer">
					<span class="material-symbols-outlined text-xl">close</span>
				</button>
			</div>
			<form action="{{ path('app_caja_nueva') }}" method="POST" enctype="multipart/form-data" class="flex flex-col flex-1 overflow-hidden">
				<input type="hidden" name="transaction[_token]" value="{{ csrf_token('submit') }}"/>
				<div class="p-lg overflow-y-auto space-y-md flex-1">
					<div>
						<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Tipo de Transacción</label>
						<select name="transaction[type]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md font-bold">
							<option value="income">Ingreso (+)</option>
							<option value="expense">Gasto (-)</option>
						</select>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Monto ($)</label>
							<input type="number" step="0.01" min="0.01" name="transaction[amount]" required placeholder="0.00" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-headline-sm font-data-mono"/>
						</div>
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Fecha</label>
							<input type="date" name="transaction[transactionDate]" required value="{{ 'now'|date('Y-m-d') }}" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-md"/>
						</div>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Categoría</label>
							<select name="transaction[category]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm">
								<option value="diezmos">Diezmos</option>
								<option value="ofrendas">Ofrendas</option>
								<option value="donaciones" selected>Donaciones</option>
								<option value="eventos">Eventos</option>
								<option value="mantenimiento">Mantenimiento</option>
								<option value="servicios">Servicios</option>
								<option value="materiales">Materiales</option>
								<option value="salarios">Salarios</option>
								<option value="misiones">Misiones</option>
								<option value="otro">Otro</option>
							</select>
						</div>
						<div>
							<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Método de Pago</label>
							<select name="transaction[paymentMethod]" class="w-full h-11 px-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm">
								<option value="efectivo" selected>Efectivo</option>
								<option value="transferencia">Transferencia Bancaria</option>
								<option value="cheque">Cheque</option>
								<option value="tarjeta_credito">Tarjeta de Crédito</option>
								<option value="tarjeta_debito">Tarjeta de Débito</option>
							</select>
						</div>
					</div>
					<div>
						<label class="block font-bold text-xs text-on-surface-variant mb-1 uppercase">Descripción</label>
						<textarea name="transaction[description]" rows="2" placeholder="Detalles de la transacción..." class="w-full p-md rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary text-body-sm"></textarea>
					</div>
				</div>
				<div class="p-md bg-surface-container-low border-t border-outline-variant flex justify-center items-center gap-sm sm:gap-md">
					<button type="button" id="cancelTxModalBtn" class="h-9 px-lg border border-outline text-on-surface-variant rounded-lg font-bold text-xs hover:bg-surface-variant cursor-pointer">Cancelar</button>
					<button type="submit" class="h-9 px-lg bg-primary text-on-primary rounded-lg font-bold text-xs hover:bg-primary-container cursor-pointer shadow-xs flex items-center gap-xs">
						<span class="material-symbols-outlined text-sm">save</span> Guardar Transacción
					</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const txModal = document.getElementById('quickTransactionModal');
			const closeBtn = document.getElementById('closeTxModalBtn');
			const cancelBtn = document.getElementById('cancelTxModalBtn');

			function openTxModal() {
				if (txModal) txModal.classList.remove('hidden');
			}
			function closeTxModal() {
				if (txModal) txModal.classList.add('hidden');
			}

			document.querySelectorAll('a[href*="/caja/nueva"], a[href$="/nueva"]').forEach(link => {
				const href = link.getAttribute('href') || '';
				if (!href.includes('/actividades/') && !href.includes('/directorio/')) {
					link.addEventListener('click', function(e) {
						e.preventDefault();
						openTxModal();
					});
				}
			});

			if (closeBtn) closeBtn.addEventListener('click', closeTxModal);
			if (cancelBtn) cancelBtn.addEventListener('click', closeTxModal);
			if (txModal) {
				txModal.addEventListener('click', function(e) {
					if (e.target === txModal) closeTxModal();
				});
			}
		});
	</script>
{% endblock %}
