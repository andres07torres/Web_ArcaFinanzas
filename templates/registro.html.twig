{% extends 'base.html.twig' %}

{% block title %}Arca Finanzas - Registro
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="https://fonts.googleapis.com" rel="preconnect"/>
	<link
	href="https://fonts.gstatic.com" rel="preconnect" crossorigin=""/>
	 <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
	<link
	href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet"/>
 <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "tertiary-fixed-dim": "#c0c1ff",
                    "on-secondary-fixed-variant": "#005049",
                    "primary": "#00236f",
                    "primary-container": "#1e3a8a",
                    "outline-variant": "#c5c5d3",
                    "on-error-container": "#93000a",
                    "on-secondary": "#ffffff",
                    "inverse-primary": "#b6c4ff",
                    "inverse-on-surface": "#eff1f3",
                    "surface-container-low": "#f2f4f6",
                    "tertiary-fixed": "#e1e0ff",
                    "tertiary": "#0d0097",
                    "surface": "#f7f9fb",
                    "on-secondary-container": "#006f66",
                    "outline": "#757682",
                    "error": "#ba1a1a",
                    "surface-bright": "#f7f9fb",
                    "on-primary-fixed": "#00164e",
                    "secondary-container": "#86f2e4",
                    "secondary": "#006a61",
                    "primary-fixed": "#dce1ff",
                    "surface-dim": "#d8dadc",
                    "on-background": "#191c1e",
                    "surface-container-lowest": "#ffffff",
                    "surface-container-highest": "#e0e3e5",
                    "on-error": "#ffffff",
                    "surface-container": "#eceef0",
                    "on-surface": "#191c1e",
                    "secondary-fixed": "#89f5e7",
                    "tertiary-container": "#2724b8",
                    "on-tertiary-fixed-variant": "#2f2ebe",
                    "on-primary": "#ffffff",
                    "on-tertiary-container": "#a1a4ff",
                    "secondary-fixed-dim": "#6bd8cb",
                    "on-surface-variant": "#444651",
                    "surface-tint": "#4059aa",
                    "primary-fixed-dim": "#b6c4ff",
                    "on-secondary-fixed": "#00201d",
                    "on-primary-container": "#90a8ff",
                    "inverse-surface": "#2d3133",
                    "surface-variant": "#e0e3e5",
                    "on-primary-fixed-variant": "#264191",
                    "background": "#f7f9fb",
                    "surface-container-high": "#e6e8ea",
                    "on-tertiary-fixed": "#07006c",
                    "error-container": "#ffdad6",
                    "on-tertiary": "#ffffff"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "spacing": {
                    "gutter": "24px",
                    "xl": "32px",
                    "lg": "24px",
                    "container-max": "1280px",
                    "xs": "4px",
                    "sm": "8px",
                    "md": "16px",
                    "base": "4px"
            },
            "fontFamily": {
                    "body-sm": ["Inter"],
                    "label-bold": ["Inter"],
                    "data-mono": ["Inter"],
                    "headline-md": ["Inter"],
                    "headline-lg-mobile": ["Inter"],
                    "body-md": ["Inter"],
                    "body-lg": ["Inter"],
                    "headline-sm": ["Inter"],
                    "headline-lg": ["Inter"]
            },
            "fontSize": {
                    "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "label-bold": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700"}],
                    "data-mono": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                    "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                    "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                    "headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
            }
          },
        },
      }
    </script>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script src="{{ asset('js/registro.js') }}"></script>
{% endblock %}

{% block body %}
	<main class="relative z-10 w-full max-w-[440px]">
		<div class="flex flex-col items-center mb-xl text-center">
			<div class="flex items-center gap-xs mb-sm">
				<span class="material-symbols-outlined text-primary text-4xl" data-icon="account_balance">account_balance</span>
				<span class="font-headline-lg text-headline-lg text-primary tracking-tight">Arca Finanzas</span>
			</div>
			<div class="flex items-center gap-xs px-md py-xs bg-surface-container-high rounded-full">
				<span class="material-symbols-outlined text-on-surface-variant text-sm" data-icon="church">church</span>
				<p class="font-label-bold text-label-bold text-on-surface-variant uppercase tracking-widest">Comunidad</p>
			</div>
		</div>
		<section class="glass-card border border-outline-variant rounded-xl shadow-sm p-lg md:p-xl w-full">
			<div class="mb-md md:mb-lg">
				<h1 class="font-headline-md text-headline-md text-on-surface mb-xs">Solicitar Acceso</h1>
				<p class="font-body-md text-body-md text-on-surface-variant">Complete los siguientes datos para que un administrador revise su solicitud.</p>
			</div>
			<form class="space-y-md" action="#" method="POST">
				<div class="flex flex-col gap-xs">
					<label class="font-label-bold text-label-bold text-on-surface-variant ml-xs" for="full_name">Nombre Completo</label>
					<div class="relative group">
						<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant transition-colors group-focus-within:text-primary" data-icon="person">person</span>
						<input class="w-full pl-[52px] pr-md py-sm md:py-md bg-surface-container-lowest border border-outline-variant rounded-xl font-body-md text-body-md outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/10" id="full_name" name="full_name" placeholder="Ej. Juan Pérez" required="" type="text"/>
					</div>
				</div>
				<div class="flex flex-col gap-xs">
					<label class="font-label-bold text-label-bold text-on-surface-variant ml-xs" for="email">Correo Electrónico</label>
					<div class="relative group">
						<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant transition-colors group-focus-within:text-primary" data-icon="mail">mail</span>
						<input class="w-full pl-[52px] pr-md py-sm md:py-md bg-surface-container-lowest border border-outline-variant rounded-xl font-body-md text-body-md outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/10" id="email" name="email" placeholder="nombre@ejemplo.com" required="" type="email"/>
					</div>
				</div>
				<div class="flex flex-col gap-xs">
					<label class="font-label-bold text-label-bold text-on-surface-variant ml-xs" for="role">Rol sugerido</label>
					<div class="relative group">
						<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant transition-colors group-focus-within:text-primary" data-icon="clinical_notes">clinical_notes</span>
						<select class="w-full pl-[52px] pr-md py-sm md:py-md bg-surface-container-lowest border border-outline-variant rounded-xl font-body-md text-body-md outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/10 cursor-pointer" id="role" name="role" required="">
							<option disabled="" selected="" value="">Seleccione un rol...</option>
							<option value="treasurer">Tesorero</option>
							<option value="leader">Líder de Actividad</option>
							<option value="volunteer">Voluntario Administrativo</option>
							<option value="pastor">Pastor / Liderazgo</option>
						</select>
					</div>
				</div>
				<div class="flex flex-col gap-xs">
					<label class="font-label-bold text-label-bold text-on-surface-variant ml-xs" for="password">Contraseña</label>
					<div class="relative group">
						<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant transition-colors group-focus-within:text-primary" data-icon="lock">lock</span>
						<input class="w-full pl-[52px] pr-xl py-sm md:py-md bg-surface-container-lowest border border-outline-variant rounded-xl font-body-md text-body-md outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/10" id="password" name="password" placeholder="••••••••" required="" type="password"/>
						<button class="absolute right-md top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors" type="button">
							<span class="material-symbols-outlined" data-icon="visibility">visibility</span>
						</button>
					</div>
					<p class="text-[11px] text-outline px-1">Mínimo 8 caracteres, incluye un número y un símbolo.</p>
				</div>
				<div class="flex items-start gap-sm pt-xs">
					<input class="mt-1 w-4 h-4 text-primary border-outline-variant rounded focus:ring-primary cursor-pointer" id="terms" name="terms" required="" type="checkbox"/>
					<label class="font-body-sm text-body-sm text-on-surface-variant leading-tight cursor-pointer" for="terms">
						Acepto los
						<a class="text-primary hover:underline font-medium" href="#">Términos y Condiciones</a>
						y la
						<a class="text-primary hover:underline font-medium" href="#">Política de Privacidad</a>
						de Arca Finanzas.
					</label>
				</div>
				<button class="bg-primary text-on-primary font-label-bold text-label-bold px-lg py-sm rounded-xl shadow-sm hover:bg-primary-container active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-sm mx-auto" type="submit">
					<span>Enviar</span>
					<span class="material-symbols-outlined text-[18px]" data-icon="arrow_forward">arrow_forward</span>
				</button>
			</form>
			<div class="mt-lg pt-md md:mt-xl md:pt-lg border-t border-outline-variant flex flex-col items-center gap-md">
				<p class="font-body-sm text-body-sm text-on-surface-variant">¿Ya tiene una cuenta?</p>
				<a class="px-lg py-sm border border-secondary text-on-secondary-container font-label-bold text-label-bold rounded-full hover:bg-secondary-container transition-colors inline-block" href="/">
					Iniciar Sesión
				</a>
			</div>
		</section>
		<div class="mt-lg md:mt-xl rounded-xl overflow-hidden h-24 md:h-32 relative border border-outline-variant">
			<div class="absolute inset-0 bg-cover bg-center grayscale opacity-40 mix-blend-overlay" data-alt="A serene landscape of a golden wheat field at sunset, symbolizing a bountiful harvest and stewardship." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDTzLo9sE2oymLQs94eUoL-_lFk12QuDtjkHir8ZnwIWrvrxSkKKxB4O3Go4FDUHXVbcUVjq6J4gbL3aEXGU6m2R3Dj5yacwWCO7Adq6doIfBLrnoSmhmSnIMhgwYl_on5rZb2YZDN9YIOWaibr2A-sF5I3wvDc4aUWQ1ydIk6sEQFdhOIzcZAxZaXWBY5FhGM_yPr2EeCfE7mQNGX5Zn12TpQYzKYXQ1JN-mMyvCeZS7KQQWMUbzDZJ594L7OfsqlF1zhMTy3jLXU')"></div>
			<div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-transparent flex items-center px-lg">
				<p class="text-on-primary font-body-sm text-body-sm italic max-w-[200px]">
					"Honra al Señor con tus bienes y con las primicias de todos tus frutos; así tus graneros se llenarán con abundancia."
				</p>
			</div>
		</div>
		<footer class="mt-lg flex justify-center gap-lg">
			<a class="font-label-bold text-label-bold text-on-surface-variant hover:text-primary" href="#">Términos</a>
			<a class="font-label-bold text-label-bold text-on-surface-variant hover:text-primary" href="#">Privacidad</a>
			<a class="font-label-bold text-label-bold text-on-surface-variant hover:text-primary" href="#">Ayuda</a>
		</footer>
	</main>
{% endblock %}
