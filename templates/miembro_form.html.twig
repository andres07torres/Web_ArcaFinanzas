{% extends 'base_dashboard.html.twig' %}

{% set active_menu = 'directorio' %}

{% block title %}Arca Finanzas - {{ title }}{% endblock %}

{% block dashboard_content %}
	<div class="p-lg max-w-container-max mx-auto w-full">
		<div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
			<div>
				<nav class="flex items-center gap-xs text-on-surface-variant font-label-bold text-label-bold mb-xs">
					<a href="{{ path('app_directorio') }}" class="hover:text-primary transition-colors">Personas</a>
					<span class="material-symbols-outlined text-xs">chevron_right</span>
					<a href="{{ path('app_directorio') }}" class="hover:text-primary transition-colors">Directorio</a>
					<span class="material-symbols-outlined text-xs">chevron_right</span>
					<span class="text-primary">{{ title }}</span>
				</nav>
				<h1 class="font-headline-lg text-headline-lg text-on-background">{{ title }}</h1>
			</div>
			<a href="{{ path('app_directorio') }}" class="flex items-center gap-sm text-on-surface-variant hover:text-primary font-label-bold text-label-bold transition-colors">
				<span class="material-symbols-outlined text-base">arrow_back</span>
				Volver al Directorio
			</a>
		</div>

		<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm">
			<div class="p-lg border-b border-outline-variant">
				<div class="flex items-center gap-md">
					<div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-on-primary-fixed">
						<span class="material-symbols-outlined text-2xl">{{ member is defined and member ? 'edit' : 'person_add' }}</span>
					</div>
					<div>
						<h2 class="font-headline-sm text-headline-sm text-on-background">{{ title }}</h2>
						<p class="text-on-surface-variant font-body-sm">{{ member is defined and member ? 'Modifica los datos del miembro' : 'Completa los datos para registrar un nuevo miembro' }}</p>
					</div>
				</div>
			</div>

			<div class="p-lg">
				{{ form_start(form, {'attr': {'class': 'space-y-lg'}}) }}
					<div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
						<div class="space-y-lg">
							{{ form_row(form.firstName) }}
						</div>
						<div class="space-y-lg">
							{{ form_row(form.lastName) }}
						</div>
						<div class="space-y-lg">
							{{ form_row(form.phone) }}
						</div>
						<div class="space-y-lg">
							{{ form_row(form.email) }}
						</div>
						<div class="space-y-lg">
							{{ form_row(form.role) }}
						</div>
						<div class="space-y-lg">
							{{ form_row(form.joinDate) }}
						</div>
					</div>

					<div class="pt-lg border-t border-outline-variant">
						<h3 class="font-headline-sm text-headline-sm text-on-background mb-lg">Dirección</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
							<div class="space-y-lg md:col-span-2">
								{{ form_row(form.address) }}
							</div>
							<div class="space-y-lg">
								{{ form_row(form.state) }}
							</div>
							<div class="space-y-lg">
								{{ form_row(form.city) }}
							</div>
							<div class="space-y-lg md:col-span-2">
								{{ form_row(form.zipCode) }}
							</div>
						</div>
					</div>

					<div class="pt-lg border-t border-outline-variant">
						<h3 class="font-headline-sm text-headline-sm text-on-background mb-lg">Notas</h3>
						<div class="grid grid-cols-1 gap-lg">
							<div class="space-y-lg">
								{{ form_row(form.notes) }}
							</div>
						</div>
					</div>

					<div class="flex flex-col sm:flex-row items-center justify-center gap-sm sm:gap-md pt-lg border-t border-outline-variant mt-lg">
						<button type="submit" class="h-11 w-full sm:w-[170px] sm:min-w-[170px] bg-primary text-on-primary rounded-lg font-label-bold text-label-bold shadow-sm hover:bg-primary-container active:scale-95 transition-all inline-flex items-center justify-center gap-xs cursor-pointer">
							<span class="material-symbols-outlined text-base">save</span>
							{{ member is defined and member ? 'Actualizar Miembro' : 'Registrar Miembro' }}
						</button>
						<a href="{{ path('app_directorio') }}" class="h-11 w-full sm:w-[170px] sm:min-w-[170px] border border-outline text-on-surface-variant rounded-lg font-label-bold text-label-bold hover:bg-surface-variant transition-all inline-flex items-center justify-center cursor-pointer">
							Cancelar
						</a>
					</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const stateSelect = document.querySelector('select[name="member[state]"]');
			const citySelect = document.querySelector('select[name="member[city]"]');
			const zipSelect = document.querySelector('select[name="member[zipCode]"]');

			if (!stateSelect || !citySelect) return;

			const postalCodeMap = {
				'Pichincha': '170150',
				'Guayas': '090150',
				'Azuay': '010150',
				'Manabí': '130150',
				'Tungurahua': '180150',
				'El Oro': '070150',
				'Loja': '110150',
				'Imbabura': '100150',
				'Chimborazo': '060150',
				'Cotopaxi': '050150',
				'Los Ríos': '120150',
				'Esmeraldas': '080150',
				'Santo Domingo de los Tsáchilas': '230150',
				'Santa Elena': '240150',
				'Carchi': '040150',
				'Cañar': '030150',
				'Bolívar': '020150',
				'Sucumbíos': '210150',
				'Napo': '150150',
				'Orellana': '220150',
				'Pastaza': '160150',
				'Morona Santiago': '140150',
				'Zamora Chinchipe': '190150',
				'Galápagos': '200150'
			};

			function updateCitiesAndZip() {
				const selectedState = stateSelect.value;
				const optgroups = citySelect.querySelectorAll('optgroup');

				optgroups.forEach(group => {
					if (!selectedState || group.label === selectedState) {
						group.style.display = '';
						group.disabled = false;
					} else {
						group.style.display = 'none';
						group.disabled = true;
					}
				});

				if (zipSelect && postalCodeMap[selectedState] && (!zipSelect.value || zipSelect.value === '')) {
					zipSelect.value = postalCodeMap[selectedState];
				}
			}

			stateSelect.addEventListener('change', updateCitiesAndZip);
			updateCitiesAndZip();
		});
	</script>
{% endblock %}
