								<td class="px-lg py-sm">Mantenimiento de Edificio</td>
								<td class="px-lg py-sm">
									<span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container text-[10px] font-bold">EGRESO</span>
								</td>
								<td class="px-lg py-sm font-data-mono text-right font-bold text-error">-$1,250.00</td>
								<td class="px-lg py-sm">
									<div class="flex items-center gap-xs">
										<span class="material-symbols-outlined text-[16px] text-secondary" style="font-variation-settings: 'FILL' 1;">verified</span>
										<span class="text-body-sm">Verificado</span>
									</div>
								</td>
								<td class="px-lg py-sm font-body-sm text-on-surface-variant">Elder John D.</td>
							</tr>
						</tbody>
					</table>
				</div>
				<div class="px-lg py-md bg-surface-container-low border-t border-outline-variant flex justify-between items-center">
