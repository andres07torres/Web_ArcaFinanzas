{% extends 'base_dashboard.html.twig' %}

{% set active_menu = 'reportes' %}

{% block title %}Reportes y Auditoría | FaithFinance{% endblock %}

{% block dashboard_content %}
		<div class="p-lg max-w-container-max mx-auto w-full">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-md mb-xl">
				<div>
					<h2 class="font-headline-lg text-headline-lg text-primary">Informe de Transparencia Financiera</h2>
					<p class="font-body-md text-body-md text-on-surface-variant mt-xs">
						{% if filters.fechaInicio and filters.fechaFin %}
							{{ filters.fechaInicio|date('d/m/Y') }} - {{ filters.fechaFin|date('d/m/Y') }}
						{% else %}
							{% if filters.periodo == 'dia' %}
								{{ "now"|date('d \\d\\e F Y') }}
							{% elseif filters.periodo == 'semana' %}
								Semana del {{ "now"|date('d \\d\\e F Y') }}
							{% else %}
								{{ "now"|date('F Y') }}
							{% endif %}
						{% endif %}
					</p>
				</div>
				<div class="flex items-center gap-sm">
					<button class="flex items-center gap-xs px-md py-sm bg-white border border-outline-variant rounded-lg text-on-surface-variant font-label-bold text-label-bold hover:bg-surface-container-low transition-colors">
						<span class="material-symbols-outlined text-[18px]">table_view</span>
						Exportar a Excel
					</button>
					<button class="flex items-center gap-xs px-md py-sm bg-primary text-on-primary rounded-lg font-label-bold text-label-bold hover:opacity-90 transition-opacity">
						<span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
						Exportar a PDF
					</button>
				</div>
			</div>

			<form method="GET" action="{{ path('app_reportes') }}" id="reportFilters">
				<div class="bg-white border border-outline-variant rounded-xl p-md mb-lg flex flex-wrap items-center gap-lg">
					<div class="flex flex-col gap-xs">
						<label class="font-label-bold text-[11px] text-outline uppercase">Rango de Fechas</label>
						<div class="flex bg-surface-container-low p-1 rounded-lg">
							<button type="submit" name="periodo" value="dia" class="px-md py-xs text-body-sm font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'dia' ? 'bg-white shadow-sm' : '' }}">Día</button>
							<button type="submit" name="periodo" value="semana" class="px-md py-xs text-body-sm font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'semana' ? 'bg-white shadow-sm' : '' }}">Semana</button>
							<button type="submit" name="periodo" value="mes" class="px-md py-xs text-body-sm font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'mes' ? 'bg-white shadow-sm' : '' }}">Mes</button>
						</div>
					</div>
					<div class="flex flex-col gap-xs">
						<label class="font-label-bold text-[11px] text-outline uppercase">Fecha Inicio</label>
						<input type="date" name="fechaInicio" value="{{ filters.fechaInicio ?? '' }}" class="bg-surface-container-low border-none rounded-lg text-body-sm font-medium focus:ring-2 focus:ring-primary h-9 min-w-[160px]"/>
					</div>
					<div class="flex flex-col gap-xs">
						<label class="font-label-bold text-[11px] text-outline uppercase">Fecha Fin</label>
						<input type="date" name="fechaFin" value="{{ filters.fechaFin ?? '' }}" class="bg-surface-container-low border-none rounded-lg text-body-sm font-medium focus:ring-2 focus:ring-primary h-9 min-w-[160px]"/>
					</div>
					<div class="flex flex-col gap-xs">
						<label class="font-label-bold text-[11px] text-outline uppercase">Filtro de Actividad</label>
						<select name="actividad" class="bg-surface-container-low border-none rounded-lg text-body-sm font-medium focus:ring-2 focus:ring-primary h-9 min-w-[200px]">
							<option value="">Todas las Actividades</option>
							{% for activity in activities %}
								<option value="{{ activity.id }}" {{ filters.actividad == activity.id ? 'selected' : '' }}>{{ activity.name }}</option>
							{% endfor %}
						</select>
					</div>
					<div class="flex flex-col gap-xs">
						<label class="font-label-bold text-[11px] text-outline uppercase">Categoría</label>
						<select name="categoria" class="bg-surface-container-low border-none rounded-lg text-body-sm font-medium focus:ring-2 focus:ring-primary h-9 min-w-[200px]">
							<option value="">Todas las Categorías</option>
							{% for cat in categories %}
								<option value="{{ cat }}" {{ filters.categoria == cat ? 'selected' : '' }}>{{ cat }}</option>
							{% endfor %}
						</select>
					</div>
					<div class="flex flex-col gap-xs">
						<label class="font-label-bold text-[11px] text-outline uppercase">Tipo</label>
						<select name="tipo" class="bg-surface-container-low border-none rounded-lg text-body-sm font-medium focus:ring-2 focus:ring-primary h-9 min-w-[160px]">
							<option value="">Todos</option>
							<option value="income" {{ filters.tipo == 'income' ? 'selected' : '' }}>Ingresos</option>
							<option value="expense" {{ filters.tipo == 'expense' ? 'selected' : '' }}>Egresos</option>
						</select>
					</div>
					<button type="submit" class="ml-auto flex items-center gap-xs text-primary font-label-bold text-label-bold hover:underline">
						<span class="material-symbols-outlined">filter_list</span>
						Aplicar Filtros
					</button>
					{% if filters.periodo != 'mes' or filters.fechaInicio or filters.actividad or filters.categoria or filters.tipo %}
						<a href="{{ path('app_reportes') }}" class="flex items-center gap-xs text-error font-label-bold text-label-bold hover:underline">
							<span class="material-symbols-outlined">close</span>
							Limpiar
						</a>
					{% endif %}
				</div>
			</form>

			<div class="bento-grid mb-lg">
				<div class="col-span-12 md:col-span-8 corte-card rounded-xl p-xl flex flex-col justify-between relative overflow-hidden">
					<div class="relative z-10">
						<div class="flex justify-between items-start mb-md">
							<div>
								<h3 class="font-label-bold text-label-bold text-outline uppercase">Posición Neta de Caja</h3>
								<p class="font-headline-lg text-headline-lg text-primary">${{ balance|number_format(2, '.', ',') }}</p>
							</div>
							{% if balance_change != 0 %}
								<div class="bg-{{ balance_change > 0 ? 'secondary-container text-on-secondary-container' : 'error-container text-on-error-container' }} px-sm py-xs rounded text-[10px] font-bold">
									{{ balance_change > 0 ? '+' : '' }}{{ balance_change }}% vs PERÍODO ANTERIOR
								</div>
							{% endif %}
						</div>
						<div class="grid grid-cols-3 gap-lg border-t border-outline-variant pt-lg mt-md">
							<div>
								<p class="text-[11px] font-label-bold text-outline uppercase">Ingresos Totales</p>
								<p class="text-body-lg font-bold text-secondary">+${{ total_income|number_format(2, '.', ',') }}</p>
							</div>
							<div>
								<p class="text-[11px] font-label-bold text-outline uppercase">Egresos Totales</p>
								<p class="text-body-lg font-bold text-error">-${{ total_expenses|number_format(2, '.', ',') }}</p>
							</div>
							<div>
								<p class="text-[11px] font-label-bold text-outline uppercase">Total Transacciones</p>
								<p class="text-body-lg font-bold">{{ total_transactions }}</p>
							</div>
						</div>
					</div>
				</div>
				<div class="col-span-12 md:col-span-4 corte-card rounded-xl p-lg border-l-4 border-l-secondary">
					<h3 class="font-label-bold text-label-bold text-outline uppercase mb-sm">Resumen del Período</h3>
					<div class="flex flex-col gap-md">
						<div class="flex items-center gap-sm">
							<span class="material-symbols-outlined text-secondary">trending_up</span>
							<div>
								<p class="text-[11px] font-label-bold text-outline uppercase">Ingresos</p>
								<p class="text-body-sm font-bold text-secondary">{{ total_income > 0 ? '+' : '' }}${{ total_income|number_format(2, '.', ',') }}</p>
							</div>
						</div>
						<div class="flex items-center gap-sm">
							<span class="material-symbols-outlined text-error">trending_down</span>
							<div>
								<p class="text-[11px] font-label-bold text-outline uppercase">Egresos</p>
								<p class="text-body-sm font-bold text-error">{{ total_expenses > 0 ? '-' : '' }}${{ total_expenses|number_format(2, '.', ',') }}</p>
							</div>
						</div>
						<div class="flex items-center gap-sm">
							<span class="material-symbols-outlined text-primary">account_balance</span>
							<div>
								<p class="text-[11px] font-label-bold text-outline uppercase">Balance Neto</p>
								<p class="text-body-sm font-bold text-primary">{{ balance >= 0 ? '+' : '' }}${{ balance|number_format(2, '.', ',') }}</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="bg-white border border-outline-variant rounded-xl overflow-hidden shadow-sm">
				<div class="px-lg py-md border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest">
					<h3 class="font-headline-sm text-headline-sm text-primary">Auditoría Detallada de Transacciones</h3>
					<div class="flex gap-sm items-center">
						{% if filters.tipo %}
							<span class="px-2 py-1 rounded-full {{ filters.tipo == 'income' ? 'bg-secondary-fixed text-on-secondary-fixed' : 'bg-error-container text-on-error-container' }} text-[10px] font-bold">
								{{ filters.tipo == 'income' ? 'INGRESOS' : 'EGRESOS' }}
							</span>
						{% endif %}
						{% if filters.categoria %}
							<span class="px-2 py-1 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold">
								{{ filters.categoria }}
							</span>
						{% endif %}
					</div>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="bg-surface-container-low border-b border-outline-variant">
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Fecha</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Descripción</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Actividad</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Categoría</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase text-right">Monto</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Método</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Registrado por</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant">
							{% for tx in transactions %}
								<tr class="{{ loop.index is odd ? '' : 'bg-surface-container-lowest/30' }} hover:bg-surface-container-lowest transition-colors">
									<td class="px-lg py-sm font-data-mono text-data-mono">{{ tx.transactionDate|date('d M, H:i') }}</td>
									<td class="px-lg py-sm font-body-sm font-semibold text-primary">{{ tx.description }}</td>
									<td class="px-lg py-sm font-body-sm">{{ tx.activity ? tx.activity.name : '---' }}</td>
									<td class="px-lg py-sm">
										{% if tx.category %}
											<span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold">{{ tx.category }}</span>
										{% else %}
											---
										{% endif %}
									</td>
									<td class="px-lg py-sm font-data-mono text-right font-bold {{ tx.type == 'income' ? 'text-secondary' : 'text-error' }}">
										{{ tx.type == 'income' ? '+' : '-' }}${{ tx.amount|number_format(2, '.', ',') }}
										<span class="px-1.5 py-0.5 rounded text-[9px] font-bold ml-1 {{ tx.type == 'income' ? 'bg-secondary-fixed text-on-secondary-fixed' : 'bg-error-container text-on-error-container' }}">
											{{ tx.type == 'income' ? 'ING' : 'EGR' }}
										</span>
									</td>
									<td class="px-lg py-sm font-body-sm text-on-surface-variant">{{ tx.paymentMethod ?? '---' }}</td>
									<td class="px-lg py-sm font-body-sm text-on-surface-variant">{{ tx.createdBy ? tx.createdBy.fullName : '---' }}</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="7" class="px-lg py-xl text-center text-on-surface-variant font-body-sm">
										<span class="material-symbols-outlined text-outline mb-sm block text-[32px]">search_off</span>
										No se encontraron transacciones para los filtros seleccionados.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if total_pages > 0 %}
					<div class="px-lg py-md bg-surface-container-low border-t border-outline-variant flex justify-between items-center">
						<p class="font-body-sm text-on-surface-variant">
							Mostrando {{ ((current_page - 1) * limit) + 1 }} a {{ min(current_page * limit, total_transactions) }} de {{ total_transactions }} resultados
						</p>
						<div class="flex gap-xs">
							{% if current_page > 1 %}
								<a href="{{ path('app_reportes', filters|merge({'page': current_page - 1})) }}" class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded bg-white text-on-surface-variant hover:bg-surface-container-high transition-colors">
									<span class="material-symbols-outlined text-[18px]">chevron_left</span>
								</a>
							{% endif %}
							{% for p in 1..total_pages %}
								{% if p <= 5 or p == total_pages or (p >= current_page - 1 and p <= current_page + 1) %}
									<a href="{{ path('app_reportes', filters|merge({'page': p})) }}" class="w-8 h-8 flex items-center justify-center border {{ p == current_page ? 'border-primary bg-primary text-on-primary' : 'border-outline-variant bg-white text-on-surface-variant' }} rounded hover:bg-surface-container-high transition-colors font-label-bold text-label-bold">
										{{ p }}
									</a>
								{% elseif p == 6 or p == total_pages - 1 %}
									<span class="w-8 h-8 flex items-center justify-center text-on-surface-variant">...</span>
								{% endif %}
							{% endfor %}
							{% if current_page < total_pages %}
								<a href="{{ path('app_reportes', filters|merge({'page': current_page + 1})) }}" class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded bg-white text-on-surface-variant hover:bg-surface-container-high transition-colors">
									<span class="material-symbols-outlined text-[18px]">chevron_right</span>
								</a>
							{% endif %}
						</div>
					</div>
				{% endif %}
			</div>

			<div class="mt-xl p-lg bg-surface-variant/20 border-2 border-dashed border-outline-variant rounded-xl flex flex-col items-center text-center">
				<span class="material-symbols-outlined text-primary mb-sm text-[32px]">security</span>
				<h4 class="font-headline-sm text-headline-sm text-primary mb-xs">Escudo de Responsabilidad de Liderazgo</h4>
				<p class="max-w-2xl font-body-md text-body-md text-on-surface-variant">Este informe fue generado utilizando protocolos de contabilidad por partida doble. Todos los datos presentados han sido cotejados con estados de cuenta bancarios y recibos físicos al {{ "now"|date('d \\d\\e F \\d\\e Y') }}. Ante cualquier discrepancia, por favor contacte al Comité de Auditoría Interna.</p>
				<div class="mt-md flex gap-lg">
					<div class="flex items-center gap-xs">
						<span class="w-3 h-3 rounded-full bg-secondary"></span>
						<span class="text-body-sm font-semibold">Registro Inmutable Bloqueado</span>
					</div>
					<div class="flex items-center gap-xs">
						<span class="w-3 h-3 rounded-full bg-secondary"></span>
						<span class="text-body-sm font-semibold">Firma de Auditor Verificada</span>
					</div>
				</div>
			</div>
		</div>
{% endblock %}
