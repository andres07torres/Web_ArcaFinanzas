{% extends 'base_dashboard.html.twig' %}

{% set active_menu = 'reportes' %}

{% block title %}Reportes y Auditoría | Arca Finanzas{% endblock %}

{% block dashboard_content %}
	{% set meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'] %}
		<div class="p-lg max-w-container-max mx-auto w-full">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-md mb-xl">
				<div>
					<nav class="flex items-center gap-xs text-on-surface-variant font-label-bold text-label-bold mb-xs">
						<span>Auditoría</span>
						<span class="material-symbols-outlined text-xs">chevron_right</span>
						<span class="text-primary">Informes</span>
					</nav>
					<h1 class="font-headline-lg text-headline-lg text-on-background">Informe de Transparencia Financiera</h1>
					<p class="font-body-md text-body-md text-on-surface-variant mt-xs">
						{% if filters.fechaInicio or filters.fechaFin %}
							{{ startDate ? startDate|date('d/m/Y') : 'Inicio' }} - {{ endDate ? endDate|date('d/m/Y') : 'Actualidad' }}
						{% elseif filters.periodo == 'dia' and startDate %}
							{{ startDate|date('d') }} de {{ meses[startDate|date('n') - 1] }} de {{ startDate|date('Y') }}
						{% elseif filters.periodo == 'semana' and startDate and endDate %}
							Semana del {{ startDate|date('d/m/Y') }} al {{ endDate|date('d/m/Y') }}
						{% elseif filters.periodo == 'mes' and startDate %}
							{{ meses[startDate|date('n') - 1]|capitalize }} de {{ startDate|date('Y') }}
						{% else %}
							Todo el historial de transacciones
						{% endif %}
					</p>
				</div>
				<div class="flex items-center gap-sm">
					<a href="{{ path('app_reportes_exportar_excel', app.request.query.all) }}" class="flex items-center gap-xs px-md py-sm bg-white border border-outline-variant rounded-lg text-on-surface-variant font-label-bold text-label-bold hover:bg-surface-container-low transition-colors shadow-xs">
						<span class="material-symbols-outlined text-[18px]">table_view</span>
						Exportar a Excel
					</a>
					<a href="{{ path('app_reportes_exportar_pdf', app.request.query.all) }}" target="_blank" class="flex items-center gap-xs px-md py-sm bg-primary text-on-primary rounded-lg font-label-bold text-label-bold hover:opacity-90 transition-opacity shadow-sm">
						<span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
						Exportar a PDF
					</a>
				</div>
			</div>

			<div class="flex flex-col lg:flex-row gap-lg">
				
				<!-- SIDEBAR DE FILTROS -->
				<div class="w-full lg:w-64 shrink-0">
					<form method="GET" action="{{ path('app_reportes') }}" id="reportFilters" class="bg-white border border-outline-variant rounded-xl p-md shadow-sm lg:sticky lg:top-6">
						<div class="flex items-center justify-between mb-md">
							<h3 class="font-headline-sm text-sm font-bold text-on-background">Filtros</h3>
							{% if filters.periodo != 'mes' or filters.fechaInicio or filters.fechaFin or filters.actividad or filters.categoria or filters.tipo %}
								<a href="{{ path('app_reportes') }}" class="text-error font-label-bold text-[10px] hover:underline flex items-center gap-0.5">
									<span class="material-symbols-outlined text-[14px]">close</span> Limpiar
								</a>
							{% endif %}
						</div>

						<div class="space-y-sm">
							<!-- Rango de Fechas -->
							<div class="flex flex-col gap-xs">
								<label class="font-label-bold text-[10px] text-outline uppercase">Período</label>
								<div class="flex flex-wrap bg-surface-container-low p-1 rounded-lg gap-1">
									<a href="{{ path('app_reportes', app.request.query.all|merge({'periodo': 'dia', 'fechaInicio': '', 'fechaFin': ''})) }}" class="flex-1 text-center py-1 text-[11px] font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'dia' and not filters.fechaInicio ? 'bg-white shadow-sm font-bold text-primary' : '' }}">Día</a>
									<a href="{{ path('app_reportes', app.request.query.all|merge({'periodo': 'semana', 'fechaInicio': '', 'fechaFin': ''})) }}" class="flex-1 text-center py-1 text-[11px] font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'semana' and not filters.fechaInicio ? 'bg-white shadow-sm font-bold text-primary' : '' }}">Semana</a>
									<a href="{{ path('app_reportes', app.request.query.all|merge({'periodo': 'mes', 'fechaInicio': '', 'fechaFin': ''})) }}" class="flex-1 text-center py-1 text-[11px] font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'mes' and not filters.fechaInicio ? 'bg-white shadow-sm font-bold text-primary' : '' }}">Mes</a>
									<a href="{{ path('app_reportes', app.request.query.all|merge({'periodo': 'todos', 'fechaInicio': '', 'fechaFin': ''})) }}" class="flex-1 text-center py-1 text-[11px] font-medium rounded-md hover:bg-white transition-colors {{ filters.periodo == 'todos' and not filters.fechaInicio ? 'bg-white shadow-sm font-bold text-primary' : '' }}">Todos</a>
								</div>
							</div>
							<input type="hidden" name="periodo" value="{{ filters.periodo }}" />

							<!-- Fechas Personalizadas -->
							<div class="grid grid-cols-2 gap-sm pt-xs">
								<div class="flex flex-col gap-xs">
									<label class="font-label-bold text-[10px] text-outline uppercase">Desde</label>
									<input type="date" name="fechaInicio" value="{{ filters.fechaInicio ?? '' }}" onchange="this.form.submit()" class="bg-surface-container-low border border-outline-variant rounded-md text-[11px] font-medium focus:ring-1 focus:ring-primary py-1.5 px-2 w-full"/>
								</div>
								<div class="flex flex-col gap-xs">
									<label class="font-label-bold text-[10px] text-outline uppercase">Hasta</label>
									<input type="date" name="fechaFin" value="{{ filters.fechaFin ?? '' }}" onchange="this.form.submit()" class="bg-surface-container-low border border-outline-variant rounded-md text-[11px] font-medium focus:ring-1 focus:ring-primary py-1.5 px-2 w-full"/>
								</div>
							</div>

							<!-- Filtros Select -->
							<div class="flex flex-col gap-xs pt-xs">
								<label class="font-label-bold text-[10px] text-outline uppercase">Actividad</label>
								<select name="actividad" onchange="this.form.submit()" class="bg-surface-container-low border border-outline-variant rounded-md text-[11px] font-medium focus:ring-1 focus:ring-primary py-1.5 px-2 w-full">
									<option value="">Todas las Actividades</option>
									{% for activity in activities %}
										<option value="{{ activity.id }}" {{ filters.actividad == activity.id ? 'selected' : '' }}>{{ activity.name }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="flex flex-col gap-xs">
								<label class="font-label-bold text-[10px] text-outline uppercase">Categoría</label>
								<select name="categoria" onchange="this.form.submit()" class="bg-surface-container-low border border-outline-variant rounded-md text-[11px] font-medium focus:ring-1 focus:ring-primary py-1.5 px-2 w-full">
									<option value="">Todas las Categorías</option>
									{% for cat in categories %}
										<option value="{{ cat }}" {{ filters.categoria == cat ? 'selected' : '' }}>{{ cat }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="flex flex-col gap-xs">
								<label class="font-label-bold text-[10px] text-outline uppercase">Tipo</label>
								<select name="tipo" onchange="this.form.submit()" class="bg-surface-container-low border border-outline-variant rounded-md text-[11px] font-medium focus:ring-1 focus:ring-primary py-1.5 px-2 w-full">
									<option value="">Todos los Tipos</option>
									<option value="income" {{ filters.tipo == 'income' ? 'selected' : '' }}>Ingresos (+)</option>
									<option value="expense" {{ filters.tipo == 'expense' ? 'selected' : '' }}>Egresos (-)</option>
								</select>
							</div>

							<div class="pt-sm">
								<button type="submit" class="w-full flex items-center justify-center gap-xs bg-primary text-on-primary rounded-md h-8 text-[11px] font-bold hover:bg-primary-container transition-colors shadow-sm">
									<span class="material-symbols-outlined text-[14px]">filter_list</span> Aplicar Filtros
								</button>
							</div>
						</div>
					</form>
				</div>

				<!-- CONTENIDO PRINCIPAL -->
				<div class="flex-1 min-w-0 flex flex-col gap-lg">
					
					<!-- TARJETAS COMPACTAS -->
					<div class="grid grid-cols-2 xl:grid-cols-4 gap-md">
						<div class="bg-white border border-outline-variant rounded-xl p-md shadow-sm">
							<p class="text-[10px] font-label-bold text-outline uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">account_balance</span> Posición Neta</p>
							<p class="text-title-lg font-bold text-primary">${{ balance|number_format(2, '.', ',') }}</p>
							{% if balance_change != 0 %}
								<p class="text-[9px] font-bold mt-1 {{ balance_change > 0 ? 'text-secondary' : 'text-error' }}">
									{{ balance_change > 0 ? '▲ +' : '▼ ' }}{{ balance_change }}% vs anterior
								</p>
							{% endif %}
						</div>
						<div class="bg-white border border-outline-variant rounded-xl p-md shadow-sm">
							<p class="text-[10px] font-label-bold text-outline uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">trending_up</span> Ingresos</p>
							<p class="text-title-lg font-bold text-secondary">+${{ total_income|number_format(2, '.', ',') }}</p>
						</div>
						<div class="bg-white border border-outline-variant rounded-xl p-md shadow-sm">
							<p class="text-[10px] font-label-bold text-outline uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">trending_down</span> Egresos</p>
							<p class="text-title-lg font-bold text-error">-${{ total_expenses|number_format(2, '.', ',') }}</p>
						</div>
						<div class="bg-white border border-outline-variant rounded-xl p-md shadow-sm">
							<p class="text-[10px] font-label-bold text-outline uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">receipt_long</span> Transacciones</p>
							<p class="text-title-lg font-bold text-on-surface">{{ total_transactions }}</p>
						</div>
					</div>

					<!-- TABLA -->
					<div class="bg-white border border-outline-variant rounded-xl overflow-hidden shadow-sm">
				<div class="px-lg py-md border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest">
					<h3 class="font-headline-sm text-headline-sm text-primary">Auditoría Detallada de Transacciones</h3>
					<div class="flex gap-sm items-center">
						{% if filters.tipo %}
							<span class="px-2 py-1 rounded-full {{ filters.tipo == 'income' ? 'bg-secondary-fixed text-on-secondary-fixed' : 'bg-error-container text-on-error-container' }} text-[10px] font-bold">
								{{ filters.tipo == 'income' ? 'INGRESOS' : 'EGRESOS' }}
							</span>
						{% endif %}
						{% if filters.categoria %}
							<span class="px-2 py-1 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold">
								{{ filters.categoria }}
							</span>
						{% endif %}
					</div>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="bg-surface-container-low border-b border-outline-variant">
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Fecha</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Descripción</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Actividad</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Categoría</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase text-right">Monto</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Método</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase">Registrado por</th>
								<th class="px-lg py-md font-label-bold text-label-bold text-outline uppercase text-center">Comprobante</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant">
							{% for tx in transactions %}
								<tr class="{{ loop.index is odd ? '' : 'bg-surface-container-lowest/30' }} hover:bg-surface-container-lowest transition-colors">
									<td class="px-lg py-sm font-data-mono text-data-mono">{{ tx.transactionDate|date('d/m/Y H:i') }}</td>
									<td class="px-lg py-sm font-body-sm font-semibold text-primary">{{ tx.description }}</td>
									<td class="px-lg py-sm font-body-sm">{{ tx.activity ? tx.activity.name : '---' }}</td>
									<td class="px-lg py-sm">
										{% if tx.category %}
											<span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold">{{ tx.category }}</span>
										{% else %}
											---
										{% endif %}
									</td>
									<td class="px-lg py-sm font-data-mono text-right font-bold {{ tx.type == 'income' ? 'text-secondary' : 'text-error' }}">
										{{ tx.type == 'income' ? '+' : '-' }}${{ tx.amount|number_format(2, '.', ',') }}
										<span class="px-1.5 py-0.5 rounded text-[9px] font-bold ml-1 {{ tx.type == 'income' ? 'bg-secondary-fixed text-on-secondary-fixed' : 'bg-error-container text-on-error-container' }}">
											{{ tx.type == 'income' ? 'ING' : 'EGR' }}
										</span>
									</td>
									<td class="px-lg py-sm font-body-sm text-on-surface-variant">{{ tx.paymentMethod ?? '---' }}</td>
									<td class="px-lg py-sm font-body-sm text-on-surface-variant">{{ tx.createdBy ? tx.createdBy.fullName : '---' }}</td>
									<td class="px-lg py-sm text-center">
										{% if tx.receiptFilename %}
											<button type="button" onclick="openReceiptPreview('{{ path('app_caja_ver_comprobante', {filename: tx.receiptFilename}) }}', '{{ tx.description|escape('js') }}', '{{ tx.receiptFilename }}')" class="inline-flex items-center gap-xs px-md py-xs bg-secondary-container/40 text-on-secondary-container border border-secondary/30 rounded-lg text-xs font-bold hover:bg-secondary-container transition-all">
												<span class="material-symbols-outlined text-base">receipt_long</span>
												Ver Comprobante
											</button>
										{% else %}
											<form method="post" action="{{ path('app_caja_subir_comprobante', {id: tx.id}) }}" enctype="multipart/form-data" class="inline-flex items-center justify-center">
												<input type="hidden" name="_csrf_token" value="{{ csrf_token('upload_receipt_' ~ tx.id) }}">
												<label class="cursor-pointer inline-flex items-center gap-xs px-sm py-xs bg-surface-container-high hover:bg-surface-variant text-on-surface-variant rounded-lg text-xs font-bold transition-all border border-outline-variant" title="Subir comprobante">
													<span class="material-symbols-outlined text-base">upload_file</span>
													<span>Subir</span>
													<input type="file" name="receipt_file" accept="image/*,.pdf" class="hidden" onchange="this.form.submit()"/>
												</label>
											</form>
										{% endif %}
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="8" class="px-lg py-xl text-center text-on-surface-variant font-body-sm">
										<span class="material-symbols-outlined text-outline mb-sm block text-[32px]">search_off</span>
										No se encontraron transacciones para los filtros seleccionados.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if total_pages > 0 %}
					<div class="px-lg py-md bg-surface-container-low border-t border-outline-variant flex justify-between items-center">
						<p class="font-body-sm text-on-surface-variant">
							Mostrando {{ ((current_page - 1) * limit) + 1 }} a {{ min(current_page * limit, total_transactions) }} de {{ total_transactions }} resultados
						</p>
						<div class="flex gap-xs">
							{% if current_page > 1 %}
								<a href="{{ path('app_reportes', filters|merge({'page': current_page - 1})) }}" class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded bg-white text-on-surface-variant hover:bg-surface-container-high transition-colors">
									<span class="material-symbols-outlined text-[18px]">chevron_left</span>
								</a>
							{% endif %}
							{% for p in 1..total_pages %}
								{% if p <= 5 or p == total_pages or (p >= current_page - 1 and p <= current_page + 1) %}
									<a href="{{ path('app_reportes', filters|merge({'page': p})) }}" class="w-8 h-8 flex items-center justify-center border {{ p == current_page ? 'border-primary bg-primary text-on-primary' : 'border-outline-variant bg-white text-on-surface-variant' }} rounded hover:bg-surface-container-high transition-colors font-label-bold text-label-bold">
										{{ p }}
									</a>
								{% elseif p == 6 or p == total_pages - 1 %}
									<span class="w-8 h-8 flex items-center justify-center text-on-surface-variant">...</span>
								{% endif %}
							{% endfor %}
							{% if current_page < total_pages %}
								<a href="{{ path('app_reportes', filters|merge({'page': current_page + 1})) }}" class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded bg-white text-on-surface-variant hover:bg-surface-container-high transition-colors">
									<span class="material-symbols-outlined text-[18px]">chevron_right</span>
								</a>
							{% endif %}
						</div>
					</div>
				{% endif %}
			</div>
		</div>

		<div id="receiptModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-sm md:p-md">
			<div class="bg-white rounded-2xl max-w-sm w-full overflow-hidden shadow-2xl flex flex-col max-h-[75vh]">
				<div class="p-md md:p-lg bg-surface-container-low border-b border-outline-variant flex justify-between items-center">
					<div class="flex items-center gap-md">
						<span class="material-symbols-outlined text-primary text-2xl">receipt_long</span>
						<div>
							<h3 id="receiptModalTitle" class="font-headline-sm text-sm font-bold text-primary">Comprobante de Pago</h3>
							<p id="receiptModalSubtitle" class="text-xs text-on-surface-variant hidden md:block">Previsualización del archivo adjunto</p>
						</div>
					</div>
					<button type="button" onclick="closeReceiptPreview()" class="p-sm text-on-surface-variant hover:text-error rounded-full transition-colors cursor-pointer">
						<span class="material-symbols-outlined">close</span>
					</button>
				</div>
				<div id="receiptModalBody" class="p-md flex-1 overflow-auto flex items-center justify-center bg-surface-container-lowest min-h-[150px]">
				</div>
				<div class="p-md bg-surface-container-low border-t border-outline-variant flex justify-between items-center">
					<span class="text-xs text-on-surface-variant font-medium">ArcaFinanzas - Verificación Contable</span>
					<a id="receiptDownloadBtn" href="#" download class="inline-flex items-center gap-xs px-lg py-sm bg-primary text-on-primary rounded-xl font-label-bold text-label-bold shadow-md hover:bg-primary-container transition-all">
						<span class="material-symbols-outlined text-base">download</span>
						Descargar Comprobante
					</a>
				</div>
			</div>
		</div>

		<script>
			function openReceiptPreview(fileUrl, title, filename) {
				const modal = document.getElementById('receiptModal');
				const modalTitle = document.getElementById('receiptModalTitle');
				const modalBody = document.getElementById('receiptModalBody');
				const downloadBtn = document.getElementById('receiptDownloadBtn');

				if (!modal || !modalBody) return;

				if (modalTitle) modalTitle.textContent = title ? ('Comprobante: ' + title) : 'Comprobante de Pago';
				if (downloadBtn) {
					downloadBtn.href = fileUrl;
					downloadBtn.setAttribute('download', filename || 'comprobante');
				}

				const ext = fileUrl.split('.').pop().toLowerCase();
				if (ext === 'pdf') {
					modalBody.innerHTML = `<iframe src="${fileUrl}" class="w-full h-[300px] border-none rounded-lg"></iframe>`;
				} else {
					modalBody.innerHTML = `<img src="${fileUrl}" alt="Comprobante" class="max-w-full max-h-[300px] object-contain rounded-lg shadow-sm border border-outline-variant"/>`;
				}

				modal.classList.remove('hidden');
			}

			function closeReceiptPreview() {
				const modal = document.getElementById('receiptModal');
				if (modal) modal.classList.add('hidden');
			}

			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') closeReceiptPreview();
			});
		</script>
{% endblock %}
