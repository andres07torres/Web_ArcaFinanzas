										<span class="text-body-sm text-on-surface-variant">Pendiente de Aprobación</span>
									</div>
								</td>
								<td class="px-lg py-sm font-body-sm text-on-surface-variant">---</td>
							</tr>
							<tr class="bg-surface-container-lowest/30 hover:bg-surface-container-lowest transition-colors">
