								<td class="px-lg py-sm font-data-mono text-data-mono">Oct 23, 11:00 AM</td>
								<td class="px-lg py-sm font-body-sm font-semibold text-primary">TRX-94818</td>
								<td class="px-lg py-sm">Retiro Juvenil</td>
								<td class="px-lg py-sm">
									<span class="px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-[10px] font-bold">INGRESO</span>
								</td>
								<td class="px-lg py-sm font-data-mono text-right font-bold text-secondary">+$3,200.00</td>
