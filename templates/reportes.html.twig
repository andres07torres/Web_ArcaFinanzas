								<td class="px-lg py-sm">
									<span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container text-[10px] font-bold">EGRESO</span>
								</td>
								<td class="px-lg py-sm font-data-mono text-right font-bold text-error">-$820.00</td>
								<td class="px-lg py-sm">
									<div class="flex items-center gap-xs">
										<span class="material-symbols-outlined text-[16px] text-secondary" style="font-variation-settings: 'FILL' 1;">verified</span>
										<span class="text-body-sm">Verificado</span>
